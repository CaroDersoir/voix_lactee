---
const base = import.meta.env.DEV
	? '/'
	: import.meta.env.BASE_URL.endsWith('/')
		? import.meta.env.BASE_URL
		: import.meta.env.BASE_URL + '/';
---

<footer class="border-t border-stone-200 bg-white">
	<div class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-sm text-stone-500 sm:px-6">
		<p>Voix Lactée</p>
		<p>Chorale catholique paroissiale</p>
		<a
			href={`${base}documents/Deroulement_Messe.pdf`}
			target="_blank"
			rel="noopener"
			class="text-sm text-stone-400 underline-offset-2 hover:text-stone-600 hover:underline"
		>
			Déroulement de la messe
		</a>
	</div>
</footer>
