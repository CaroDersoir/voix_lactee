---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<Layout title="Contact | Voix Lactee">
    <SectionTitle title="Contact" subtitle="Pour contacter la chorale."/>
    <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <ul class="space-y-3 text-stone-700">
            <li><span class="font-semibold text-stone-900">Cheffe de choeur :</span> Clémence la cheffe</li>
            <li>
                <span class="font-semibold text-stone-900">Email :</span>
                <a class="text-blue-800 underline" href="mailto:contact@voixlactee.fr">cestsecret@voixlactee.fr</a>
            </li>
            <li>
                <span class="font-semibold text-stone-900">Numéro de téléphone :</span> Comme si on allait donner son
                07...
            </li>
            <li><span class="font-semibold text-stone-900">Aumônerie :</span> Saint Serge, Angers</li>
        </ul>
    </section>
</Layout>
