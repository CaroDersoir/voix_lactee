				<a class="text-emerald-800 underline" href="mailto:contact@voixlactee.fr">contact@voixlactee.fr</a>
			</li>
			<li><span class="font-semibold text-stone-900">Paroisse :</span> Saint Jean Baptiste, Lyon</li>
		</ul>
	</section>
