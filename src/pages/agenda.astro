---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';

const events = await getCollection('events');
const upcomingEvents = events.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Layout title="Agenda | Voix Lactee">
	<SectionTitle title="Agenda" subtitle="Messes et evenements a venir." />
	<div class="grid gap-4">
		{
			upcomingEvents.map((event) => (
				<article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
					<h2 class="text-lg font-semibold text-emerald-950">{event.data.title}</h2>
					<p class="mt-2 text-sm text-stone-600">
						{event.data.date.toLocaleDateString('fr-FR')} a {event.data.time} - {event.data.location}
					</p>
					<p class="mt-3 text-stone-700">{event.data.description}</p>
				</article>
			))
		}
	</div>
</Layout>
