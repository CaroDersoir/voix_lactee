---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const events    = await getCollection('events');
const allSongs  = await getCollection('songs');
const songsByPdf: Record<string, string> = {};
const songMultiPdfsMap: Record<string, Array<{label: string, url: string}>> = {};
const songAudiosMap: Record<string, Record<string, string>> = {};
allSongs.forEach(s => {
  if (s.data.pdf) {
    songsByPdf[s.data.pdf] = s.data.title;
    if (s.data.pdfs && s.data.pdfs.length > 1) {
      songMultiPdfsMap[s.data.pdf] = s.data.pdfs;
    }
    const entry: Record<string, string> = {};
    if (s.data.audio_soprano) entry.s = s.data.audio_soprano;
    if (s.data.audio_alto) entry.a = s.data.audio_alto;
    if (s.data.audio_tenor) entry.t = s.data.audio_tenor;
    if (s.data.audio_basse) entry.b = s.data.audio_basse;
    if (Object.keys(entry).length > 0) songAudiosMap[s.data.pdf] = entry;
  }
});
const today = new Date();
today.setHours(0, 0, 0, 0);

const allEvents = events
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .map(event => {
    const prog: Record<string, string> = {};
    ['entree_maries','chant_entree','procession_entree','esprit_saint','accueil','kyrie','gloria','psaume','alleluia','benediction_alliances','louange','priere_universelle','notre_pere','offertoire','sanctus','agnus','communion','signature_registres','post_communion','action_grace','vierge','envoi','chant_final','chant_sortie','sortie_maries','en_plus','en_plus_2','en_plus_3'].forEach(k => {
      const v = (event.data as any)['program_' + k] as string | undefined;
      if (v) prog[k] = v;
    });
    return { ...event, progJson: JSON.stringify(prog) };
  });

const upcomingEvents = allEvents.filter(e => e.data.date >= today);
const pastEvents = allEvents.filter(e => e.data.date < today).reverse();
---

<Layout title="Agenda | Voix Lactée">

	<SectionTitle title="Agenda" subtitle="Messes et événements." />

	<div class="grid gap-4">
		{upcomingEvents.map((event) => (
		<article
			class="event-card cursor-pointer rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition hover:border-blue-300 hover:shadow-md"
			data-id={event.id}
			data-title={event.data.title}
			data-date={event.data.date.toISOString().split('T')[0]}
			data-time={event.data.time}
			data-location={event.data.location}
			data-description={event.data.description ?? ''}
			data-type={event.data.type ?? ''}
			data-animateur={event.data.animateur ?? ''}
			data-chef-choeur={event.data.chef_choeur ?? ''}
			data-organiste={event.data.organiste ?? ''}
			data-program={event.progJson}
		>
				<h2 class="text-lg font-semibold text-blue-950">{event.data.title}</h2>
				<p class="mt-2 text-sm text-stone-500">
					{event.data.date.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}{event.data.time ? ` à ${event.data.time}` : ''} — {event.data.location}
				</p>
				{event.data.description && (
					<p class="mt-3 text-sm text-stone-700">{event.data.description}</p>
				)}
			</article>
		))}

		{upcomingEvents.length === 0 && (
			<p class="text-sm italic text-stone-400">Aucun événement à venir.</p>
		)}

		{pastEvents.length > 0 && (
			<div class="flex items-center gap-3 py-1">
				<div class="h-px flex-1 bg-stone-200"></div>
				<span class="text-xs font-semibold uppercase tracking-widest text-stone-400">Passés</span>
				<div class="h-px flex-1 bg-stone-200"></div>
			</div>
		)}

		{pastEvents.map((event) => (
		<article
			class="event-card cursor-pointer rounded-xl border border-stone-200 bg-stone-50 p-5 shadow-sm transition opacity-60 hover:opacity-80 hover:border-stone-300 hover:shadow-md"
			data-id={event.id}
			data-title={event.data.title}
			data-date={event.data.date.toISOString().split('T')[0]}
			data-time={event.data.time}
			data-location={event.data.location}
			data-description={event.data.description ?? ''}
			data-type={event.data.type ?? ''}
			data-animateur={event.data.animateur ?? ''}
			data-chef-choeur={event.data.chef_choeur ?? ''}
			data-organiste={event.data.organiste ?? ''}
			data-program={event.progJson}
		>
				<h2 class="text-lg font-semibold text-stone-500">{event.data.title}</h2>
				<p class="mt-2 text-sm text-stone-400">
					{event.data.date.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}{event.data.time ? ` à ${event.data.time}` : ''} — {event.data.location}
				</p>
				{event.data.description && (
					<p class="mt-3 text-sm text-stone-400">{event.data.description}</p>
				)}
			</article>
		))}
	</div>

	<div id="songs-data" data-map={JSON.stringify(songsByPdf)} data-multi-pdfs={JSON.stringify(songMultiPdfsMap)} data-audios={JSON.stringify(songAudiosMap)} data-base={base} hidden></div>

	<!-- Visionneuse PDF -->
	<div id="pdf-overlay" class="fixed inset-0 z-[60] flex items-center justify-center bg-black/75 p-3" style="display: none;">
		<div class="relative flex h-[95vh] w-[95vw] flex-col overflow-hidden rounded-xl bg-white shadow-2xl">
			<div class="flex shrink-0 items-center justify-between border-b border-stone-200 px-4 py-3">
				<div class="flex items-center gap-2">
					<span id="pdf-status" class="text-sm text-stone-500">Chargement…</span>
					<button id="pdf-zoom-out" class="flex h-7 w-7 items-center justify-center rounded border border-stone-300 text-lg leading-none text-stone-600 hover:bg-stone-100" title="Réduire">−</button>
					<button id="pdf-zoom-in"  class="flex h-7 w-7 items-center justify-center rounded border border-stone-300 text-lg leading-none text-stone-600 hover:bg-stone-100" title="Agrandir">+</button>
				</div>
				<div class="flex items-center gap-2">
					<button id="btn-close-pdf" class="flex items-center gap-2 rounded-lg bg-blue-900 px-4 py-2.5 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-blue-700">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
						</svg>
						Fermer
					</button>
				</div>
			</div>
			<div id="pdf-container" class="flex flex-1 flex-col items-center gap-4 overflow-auto bg-stone-100 p-4"></div>
		</div>
	</div>

	<!-- Sélecteur de partition (multi-PDF) -->
	<div id="pdf-picker" class="fixed z-[70] rounded-lg border border-stone-200 bg-white py-1 shadow-lg" style="display:none; min-width:10rem;"></div>

	<!-- Modale détail + inscription -->
	<div id="modal-detail" class="fixed inset-0 z-50 items-center justify-center bg-black/50 p-4" style="display:none;">
		<div class="relative w-full max-w-4xl rounded-xl bg-white shadow-xl" style="max-height:90vh;">

			<div class="flex items-center justify-between border-b border-stone-200 px-6 py-4">
				<h2 id="detail-title" class="text-xl font-semibold text-blue-950"></h2>
				<button id="btn-close-detail" class="rounded-full p-1 text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-900" aria-label="Fermer">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
					</svg>
				</button>
			</div>

			<div class="space-y-5 overflow-y-auto px-6 py-5" style="max-height:calc(90vh - 76px);">
				<div class="flex items-start gap-4">
					<div class="flex-1">
						<p id="detail-datetime" class="text-sm text-stone-500"></p>
						<p id="detail-location" class="text-sm text-stone-500"></p>
						<p id="detail-description" class="mt-3 text-stone-700"></p>
						<div id="detail-team" class="mt-2 hidden flex-wrap gap-4 text-xs text-stone-500"></div>
					</div>
					<button id="btn-merge-pdf" style="display:none; background-color:#D4B86A;" class="flex h-24 w-24 flex-shrink-0 flex-col items-center justify-center rounded-xl text-center text-xs font-bold leading-snug text-black shadow-md transition-colors disabled:opacity-50">
						<span>C'est l'heure</span>
						<span>les enfants</span>
					</button>
				</div>

				<div id="detail-program-section" class="hidden">
					<h3 class="mb-2 border-b border-stone-100 pb-1 text-base font-semibold text-stone-800">Programme</h3>
					<div id="detail-voice-btns" class="mb-2 flex-wrap gap-1.5" style="display:none;"></div>
					<div id="detail-program" class="grid grid-cols-1 gap-y-1.5 text-sm sm:grid-cols-2 sm:gap-x-6"></div>
				<button id="btn-download-zip" class="mt-3 hidden items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-sm font-medium text-blue-700 transition-colors hover:bg-blue-100 disabled:opacity-50">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
					</svg>
					<span id="btn-download-zip-label">Télécharger toutes les partitions (ZIP)</span>
				</button>
				</div>

				<div>
					<h3 class="mb-3 border-b border-stone-100 pb-1 text-base font-semibold text-stone-800">Inscriptions</h3>
					<div id="detail-signups-list" class="mb-4 space-y-2 text-sm"></div>
					<div class="rounded-lg border border-stone-200 bg-stone-50 p-4">
						<h4 class="mb-3 text-sm font-semibold text-stone-700">S'inscrire</h4>
						<form id="form-signup" class="space-y-3">
							<div>
								<label class="mb-1 block text-xs font-medium text-stone-600">Nom <span class="text-red-500">*</span></label>
								<input id="signup-name" type="text" required placeholder="Votre prénom et nom"
									class="w-full rounded-lg border border-stone-300 px-3 py-1.5 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
							</div>
							<div>
								<label class="mb-1 block text-xs font-medium text-stone-600">Instrument</label>
								<input id="signup-instrument" type="text" placeholder="Ex. : guitare, piano, violon…"
									class="w-full rounded-lg border border-stone-300 px-3 py-1.5 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
							</div>
							<div>
								<p class="mb-1.5 text-xs font-medium text-stone-600">Pupitre vocal</p>
								<div class="flex flex-wrap gap-5">
									{['Soprano', 'Alto', 'Ténor', 'Basse'].map((v) => (
										<label class="flex cursor-pointer items-center gap-1.5">
											<input type="radio" name="signup-voice" value={v} class="accent-blue-700" />
											<span class="text-sm text-stone-700">{v}</span>
										</label>
									))}
								</div>
							</div>
							<button type="submit" class="w-full rounded-lg bg-blue-800 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700">
								S'inscrire
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Visionneuse YouTube -->
	<div id="yt-overlay" class="fixed inset-0 z-[70] flex items-center justify-center bg-black/80 p-3" style="display:none;">
		<div class="flex w-full max-w-3xl flex-col overflow-hidden rounded-xl bg-black shadow-2xl">
			<div class="flex items-center gap-2 px-3 py-2">
				<span id="yt-track-info" class="flex-1 truncate text-xs text-white/60"></span>
				<button id="btn-next-yt" class="hidden rounded bg-white/10 px-2.5 py-1 text-xs font-medium text-white transition-colors hover:bg-white/20">Suivant ▶</button>
				<button id="btn-close-yt" class="flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-2 text-sm font-semibold text-white backdrop-blur transition-colors hover:bg-white/20">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
					</svg>
					Fermer
				</button>
			</div>
			<div style="padding-top:56.25%;position:relative;">
				<div id="yt-player" class="absolute inset-0"></div>
			</div>
		</div>
	</div>

</Layout>

<script>
	import * as pdfjsLib from 'pdfjs-dist';
	pdfjsLib.GlobalWorkerOptions.workerSrc = import.meta.env.BASE_URL + 'pdf.worker.min.mjs';
	import JSZip from 'jszip';
	import { PDFDocument } from 'pdf-lib';

	let currentDetailId: string | null = null;
	let currentPdfEntries: Array<{ name: string; url: string }> = [];
	const modalAudio = new Audio();
	let currentModalAudioBtn: HTMLButtonElement | null = null;

	// ── Overlay YouTube + playlist par voix ───────────────────
	const ytOverlay = document.getElementById('yt-overlay') as HTMLElement;
	const ytTrackInfo = document.getElementById('yt-track-info') as HTMLElement;
	const btnNextYt = document.getElementById('btn-next-yt') as HTMLButtonElement;

	let ytPlayer: any = null;
	let videoQueue: Array<{id: string; title: string}> = [];
	let queueIndex = 0;

	function getYouTubeId(url: string): string | null {
		const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
		return m ? m[1] : null;
	}

	function updateTrackInfo() {
		const isPlaylist = videoQueue.length > 1;
		const item = videoQueue[queueIndex];
		ytTrackInfo.textContent = isPlaylist
			? `${queueIndex + 1} / ${videoQueue.length}${item?.title ? ' — ' + item.title : ''}`
			: (item?.title || '');
		btnNextYt.classList.toggle('hidden', !isPlaylist || queueIndex >= videoQueue.length - 1);
	}

	function playQueueItem(index: number) {
		queueIndex = index;
		updateTrackInfo();
		ytPlayer?.loadVideoById(videoQueue[index]?.id);
	}

	function playNextInQueue() {
		if (queueIndex + 1 < videoQueue.length) playQueueItem(queueIndex + 1);
		else closeYouTubeOverlay();
	}

	function showOverlayAndPlay() {
		ytOverlay.style.display = 'flex';
		document.body.style.overflow = 'hidden';
		updateTrackInfo();
		if (ytPlayer?.loadVideoById) {
			ytPlayer.loadVideoById(videoQueue[queueIndex]?.id);
			return;
		}
		(window as any).onYouTubeIframeAPIReady = () => {
			ytPlayer = new (window as any).YT.Player('yt-player', {
				playerVars: { autoplay: 1, rel: 0, modestbranding: 1 },
				events: {
					onReady: () => ytPlayer.loadVideoById(videoQueue[queueIndex]?.id),
					onStateChange: (e: any) => { if (e.data === 0) playNextInQueue(); }
				}
			});
		};
		if ((window as any).YT?.Player) {
			(window as any).onYouTubeIframeAPIReady();
		} else {
			const tag = document.createElement('script');
			tag.src = 'https://www.youtube.com/iframe_api';
			document.head.appendChild(tag);
		}
	}

	function closeYouTubeOverlay() {
		ytOverlay.style.display = 'none';
		ytPlayer?.stopVideo?.();
		document.body.style.overflow = '';
	}

	document.getElementById('btn-close-yt')!.addEventListener('click', closeYouTubeOverlay);
	btnNextYt.addEventListener('click', playNextInQueue);
	ytOverlay.addEventListener('click', (e) => { if (e.target === ytOverlay) closeYouTubeOverlay(); });

	function loadSignups(id: string): any[] { try { return JSON.parse(localStorage.getItem('vl_signups_' + id) || '[]'); } catch { return []; } }
	function saveSignups(id: string, d: any[]) { localStorage.setItem('vl_signups_' + id, JSON.stringify(d)); }
	function cap(s: string) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }

	function fmtDate(str: string) {
		return new Date(str + 'T00:00:00').toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
	}

	function renderSignupsList(eventId: string) {
		const signups = loadSignups(eventId);
		const list = document.getElementById('detail-signups-list')!;
		if (!signups.length) {
			list.innerHTML = '<p class="text-sm italic text-stone-400">Aucune inscription pour le moment.</p>';
			return;
		}
		list.innerHTML = signups.map((s: any) => `
			<div class="flex items-center gap-2 rounded-lg border border-stone-100 bg-white px-3 py-2">
				<span class="font-medium text-stone-800">${s.name}</span>
				${s.voice ? `<span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs text-blue-700">${cap(s.voice)}</span>` : ''}
				${s.instrument ? `<span class="text-stone-400">—</span><span class="text-stone-600">${s.instrument}</span>` : ''}
			</div>
		`).join('');
	}

	const songsDataEl = document.getElementById('songs-data') as HTMLElement;
	const songsMap: Record<string, string> = JSON.parse(songsDataEl?.dataset.map || '{}');
	const multiPdfsMap: Record<string, Array<{label: string, url: string}>> = JSON.parse(songsDataEl?.dataset.multiPdfs || '{}');
	const base = songsDataEl?.dataset.base || '/';
	const audiosMap: Record<string, Record<string, string>> = JSON.parse(songsDataEl?.dataset.audios || '{}');

	function makeVoiceButtons(pdfPath: string, songTitle = ''): string {
		const songAudios = audiosMap[pdfPath] || {};
		const VNAMES: Record<string, string> = {s:'Soprano', a:'Alto', t:'Ténor', b:'Basse'};
		return ['s','a','t','b'].map(voice => {
			const ap = songAudios[voice];
			if (!ap) return '';
			const ext = ap.startsWith('http://') || ap.startsWith('https://');
			const url = ext ? ap : `${base}${ap.replace(/^\/+/, '')}`;
			const cls = ext ? 'bg-red-50 text-red-600 hover:bg-red-100' : 'bg-blue-50 text-blue-700 hover:bg-blue-100';
			return `<button class="agenda-audio-btn flex-shrink-0 inline-flex h-5 w-5 items-center justify-center rounded-full ${cls} text-xs font-bold" data-audio-url="${url}" data-is-external="${ext}" data-voice="${voice}" data-song-title="${songTitle.replace(/"/g, '&quot;')}" title="${VNAMES[voice]}">${voice.toUpperCase()}</button>`;
		}).join('');
	}

	const SLOT_LABELS: Record<string, string> = {
		entree_maries: 'Entrée des mariés',
		chant_entree: "Chant d'entrée",
		procession_entree: "Procession d'entrée",
		esprit_saint: "Chant à l'Esprit Saint",
		accueil: 'Accueil', kyrie: 'Kyrie', gloria: 'Gloria', psaume: 'Psaume',
		alleluia: 'Alléluia',
		benediction_alliances: 'Bénédiction des alliances',
		louange: 'Louange',
		priere_universelle: 'Prière universelle', offertoire: 'Offertoire',
		notre_pere: 'Notre Père',
		sanctus: 'Sanctus', agnus: 'Agnus Dei', communion: 'Communion',
		signature_registres: 'Signature des registres',
		post_communion: 'Post-communion', action_grace: 'Action de grâce',
		vierge: 'Chant à la Vierge', envoi: 'Envoi',
		chant_final: 'Chant final',
		chant_sortie: 'Chant de sortie',
		sortie_maries: 'Sortie des mariés',
		en_plus: 'En plus (1)', en_plus_2: 'En plus (2)', en_plus_3: 'En plus (3)',
	};

	function openDetail(card: HTMLElement) {
		const id = card.dataset.id!;
		currentDetailId = id;
		document.getElementById('detail-title')!.textContent = card.dataset.title!;
		document.getElementById('detail-datetime')!.textContent = card.dataset.time ? `${fmtDate(card.dataset.date!)} à ${card.dataset.time}` : fmtDate(card.dataset.date!);
		document.getElementById('detail-location')!.textContent = card.dataset.location!;
		const descEl = document.getElementById('detail-description')!;
		descEl.textContent = card.dataset.description || '';
		descEl.style.display = card.dataset.description ? 'block' : 'none';

		// Équipe
		const teamEl = document.getElementById('detail-team')!;
		const anim = card.dataset.animateur || '';
		const chef = card.dataset.chefChoeur || '';
		const org  = card.dataset.organiste || '';
		if (anim || chef || org) {
			teamEl.innerHTML = [
				anim ? `<span>Animateur·ice : <strong>${anim}</strong></span>` : '',
				chef ? `<span>Chef·fe de chœur : <strong>${chef}</strong></span>` : '',
				org  ? `<span>Organiste : <strong>${org}</strong></span>` : '',
			].filter(Boolean).join('');
			teamEl.classList.remove('hidden');
			teamEl.style.display = 'flex';
		} else {
			teamEl.classList.add('hidden');
			teamEl.style.display = 'none';
		}

		// Programme
		const progSection = document.getElementById('detail-program-section')!;
		const progEl = document.getElementById('detail-program')!;
		let prog: Record<string, string> = {};
		try { prog = JSON.parse(card.dataset.program || '{}'); } catch {}
		const progEntries = Object.entries(prog).filter(([, v]) => v);
		const dlBtn = document.getElementById('btn-download-zip') as HTMLButtonElement;
		const dlLabel = document.getElementById('btn-download-zip-label') as HTMLSpanElement;
		if ((card.dataset.type === 'messe' || card.dataset.type === 'messe_mariage' || card.dataset.type === 'benediction') && progEntries.length > 0) {
			currentPdfEntries = [];
			progEl.innerHTML = progEntries.map(([k, v]) => {
				const songTitle = songsMap[v] || v.split('/').pop()?.replace(/\.pdf$/i, '') || '';
				const pdfUrl = `${base}${v.replace(/^\/+/, '')}`;
				const multiPdfs = multiPdfsMap[v];
				if (multiPdfs && multiPdfs.length > 1) {
					multiPdfs.forEach(p => {
						currentPdfEntries.push({ name: `${songTitle} - ${p.label}`, url: `${base}${p.url.replace(/^\/+/, '')}` });
					});
					const pdfsAttr = JSON.stringify(multiPdfs.map(p => ({ label: p.label, url: `${base}${p.url.replace(/^\/+/, '')}` }))).replace(/"/g, '&quot;');
					return `<div class="flex items-center gap-1.5">
						<span class="w-32 flex-shrink-0 text-xs font-medium text-stone-500">${SLOT_LABELS[k] ?? k}</span>
						<span class="truncate text-xs text-stone-800">${songTitle}</span>
						${makeVoiceButtons(v, songTitle)}
						<button class="agenda-pdf-btn flex-shrink-0 rounded px-1.5 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100" data-pdfs="${pdfsAttr}" title="Choisir la partition">PDF ▾</button>
					</div>`;
				}
				currentPdfEntries.push({ name: songTitle || v.split('/').pop() || k, url: pdfUrl });
				return `<div class="flex items-center gap-1.5">
					<span class="w-32 flex-shrink-0 text-xs font-medium text-stone-500">${SLOT_LABELS[k] ?? k}</span>
					<span class="truncate text-xs text-stone-800">${songTitle}</span>
					${makeVoiceButtons(v, songTitle)}
					${v ? `<button class="agenda-pdf-btn flex-shrink-0 rounded px-1.5 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100" data-url="${pdfUrl}" title="Voir la partition">PDF</button>` : ''}
				</div>`;
			}).join('');

			// Boutons "jouer toute la voix"
			const voiceBtnsEl = document.getElementById('detail-voice-btns') as HTMLElement;
			const VFULL: Record<string, string> = {s:'Soprano', a:'Alto', t:'Ténor', b:'Basse'};
			const voicesPresent = new Set<string>();
			progEntries.forEach(([, v]) => { ['s','a','t','b'].forEach(voice => { if ((audiosMap[v] || {})[voice]) voicesPresent.add(voice); }); });
			if (voicesPresent.size > 0) {
				voiceBtnsEl.innerHTML = ['s','a','t','b'].filter(v => voicesPresent.has(v))
					.map(v => `<button class="voice-playlist-btn rounded-full bg-red-50 px-2.5 py-1 text-xs font-medium text-red-600 transition-colors hover:bg-red-100" data-voice="${v}">▶ ${VFULL[v]}</button>`)
					.join('');
				voiceBtnsEl.style.display = 'flex';
			} else {
				voiceBtnsEl.innerHTML = '';
				voiceBtnsEl.style.display = 'none';
			}

			progSection.style.display = 'block';
			dlBtn.style.display = 'inline-flex';
			dlBtn.disabled = false;
			dlLabel.textContent = 'Télécharger toutes les partitions (ZIP)';
			(document.getElementById('btn-merge-pdf') as HTMLButtonElement).style.display = 'flex';
		} else {
			currentPdfEntries = [];
			progSection.style.display = 'none';
			dlBtn.style.display = 'none';
			(document.getElementById('btn-merge-pdf') as HTMLButtonElement).style.display = 'none';
		}

		renderSignupsList(id);
		(document.getElementById('form-signup') as HTMLFormElement).reset();
		document.getElementById('modal-detail')!.style.display = 'flex';
		document.body.style.overflow = 'hidden';
	}

	function closeDetail() {
		modalAudio.pause();
		if (currentModalAudioBtn) { currentModalAudioBtn.classList.remove('ring-2', 'ring-blue-700', 'ring-offset-1'); currentModalAudioBtn = null; }
		document.getElementById('modal-detail')!.style.display = 'none';
		document.body.style.overflow = '';
		currentDetailId = null;
	}

	document.querySelectorAll<HTMLElement>('.event-card').forEach(card => {
		card.addEventListener('click', () => openDetail(card));
	});

	document.getElementById('btn-close-detail')!.addEventListener('click', closeDetail);
	document.getElementById('modal-detail')!.addEventListener('click', e => {
		if (e.target === document.getElementById('modal-detail')) closeDetail();
	});

	document.getElementById('form-signup')!.addEventListener('submit', e => {
		e.preventDefault();
		if (!currentDetailId) return;
		const name = (document.getElementById('signup-name') as HTMLInputElement).value.trim();
		if (!name) return;
		const signup = {
			id: Date.now().toString(),
			name,
			instrument: (document.getElementById('signup-instrument') as HTMLInputElement).value.trim(),
			voice: (document.querySelector('input[name="signup-voice"]:checked') as HTMLInputElement | null)?.value || '',
		};
		const signups = loadSignups(currentDetailId);
		signups.push(signup);
		saveSignups(currentDetailId, signups);
		renderSignupsList(currentDetailId);
		(document.getElementById('form-signup') as HTMLFormElement).reset();
	});

	// ── Téléchargement ZIP des partitions ─────────────────────
	document.getElementById('btn-download-zip')!.addEventListener('click', async () => {
		if (!currentPdfEntries.length) return;
		const btn = document.getElementById('btn-download-zip') as HTMLButtonElement;
		const label = document.getElementById('btn-download-zip-label') as HTMLSpanElement;
		btn.disabled = true;
		label.textContent = 'Téléchargement en cours…';

		try {
			const zip = new JSZip();
			const seen = new Map<string, number>();
			await Promise.all(currentPdfEntries.map(async ({ name, url }) => {
				const res = await fetch(url);
				const buf = await res.arrayBuffer();
				const count = seen.get(name) ?? 0;
				seen.set(name, count + 1);
				const filename = count === 0 ? `${name}.pdf` : `${name} (${count}).pdf`;
				zip.file(filename, buf);
			}));
			const blob = await zip.generateAsync({ type: 'blob' });
			const a = document.createElement('a');
			a.href = URL.createObjectURL(blob);
			a.download = `partitions.zip`;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(a.href);
		} finally {
			btn.disabled = false;
			label.textContent = 'Télécharger toutes les partitions (ZIP)';
		}
	});

	// ── PDF fusionné ──────────────────────────────────────────
	document.getElementById('btn-merge-pdf')!.addEventListener('click', async () => {
		if (!currentPdfEntries.length) return;
		const btn = document.getElementById('btn-merge-pdf') as HTMLButtonElement;
		btn.disabled = true;
		const saved = btn.innerHTML;
		btn.innerHTML = '<span style="font-size:1.4rem">⏳</span>';

		try {
			const merged = await PDFDocument.create();
			for (const { url } of currentPdfEntries) {
				const res = await fetch(url);
				const buf = await res.arrayBuffer();
				const pdf = await PDFDocument.load(buf, { ignoreEncryption: true });
				const pages = await merged.copyPages(pdf, pdf.getPageIndices());
				pages.forEach(p => merged.addPage(p));
			}
			const bytes = await merged.save();
			const blob = new Blob([bytes], { type: 'application/pdf' });
			const url = URL.createObjectURL(blob);
			openPdf(url);
		} finally {
			btn.disabled = false;
			btn.innerHTML = saved;
		}
	});

	// ── Visionneuse PDF (pdfjs-dist) ──────────────────────────
	const pdfOverlay   = document.getElementById('pdf-overlay')   as HTMLElement;
	const pdfContainer = document.getElementById('pdf-container') as HTMLElement;
	const pdfStatus    = document.getElementById('pdf-status')    as HTMLElement;
	let pdfLoadingTask: any = null;
	let pdfZoom = 1.0;
	const pdfPages: Array<{el: HTMLCanvasElement; w: number; h: number}> = [];

	function applyZoom() {
		pdfPages.forEach(p => {
			p.el.style.width  = `${p.w * pdfZoom}px`;
			p.el.style.height = `${p.h * pdfZoom}px`;
		});
	}

	document.getElementById('pdf-zoom-in')!.addEventListener('click', () => {
		pdfZoom = Math.min(3, pdfZoom * 1.25);
		applyZoom();
	});
	document.getElementById('pdf-zoom-out')!.addEventListener('click', () => {
		pdfZoom = Math.max(0.25, pdfZoom / 1.25);
		applyZoom();
	});

	// Scroll + pincement via Pointer Events (touch-action:none donne le contrôle total)
	pdfContainer.style.touchAction = 'none';
	const _ptrs = new Map<number, PointerEvent>();
	let _pinchDist = 0;
	let _scrollStart = { y: 0, top: 0 };

	pdfContainer.addEventListener('pointerdown', (e) => {
		_ptrs.set(e.pointerId, e);
		pdfContainer.setPointerCapture(e.pointerId);
		if (_ptrs.size === 1) {
			_scrollStart = { y: e.clientY, top: pdfContainer.scrollTop };
		}
		if (_ptrs.size === 2) {
			const [a, b] = [..._ptrs.values()];
			_pinchDist = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
		}
	});
	pdfContainer.addEventListener('pointermove', (e) => {
		if (!_ptrs.has(e.pointerId)) return;
		_ptrs.set(e.pointerId, e);
		if (_ptrs.size === 1) {
			pdfContainer.scrollTop = _scrollStart.top + (_scrollStart.y - e.clientY);
		} else if (_ptrs.size === 2) {
			const [a, b] = [..._ptrs.values()];
			const dist = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
			if (_pinchDist > 0) {
				pdfZoom = Math.min(3, Math.max(0.25, pdfZoom * dist / _pinchDist));
				applyZoom();
			}
			_pinchDist = dist;
		}
	}, { passive: false });
	pdfContainer.addEventListener('pointerup', (e) => {
		_ptrs.delete(e.pointerId);
		if (_ptrs.size < 2) _pinchDist = 0;
		if (_ptrs.size === 1) {
			const [r] = [..._ptrs.values()];
			_scrollStart = { y: r.clientY, top: pdfContainer.scrollTop };
		}
	});
	pdfContainer.addEventListener('pointercancel', (e) => {
		_ptrs.delete(e.pointerId);
		if (_ptrs.size < 2) _pinchDist = 0;
	});

	async function openPdf(url: string) {
		if (localStorage.getItem('vl_pdf_pref') === 'tab') {
			window.open(url, '_blank', 'noopener');
			return;
		}
		if (pdfLoadingTask) pdfLoadingTask.destroy();
		pdfContainer.innerHTML = '';
		pdfPages.length = 0;
		pdfZoom = 1.0;
		pdfStatus.textContent = 'Chargement…';
		pdfOverlay.style.display = 'flex';
		document.body.style.overflow = 'hidden';
		try {
			pdfLoadingTask = pdfjsLib.getDocument(url);
			const pdf = await pdfLoadingTask.promise;
			const w = Math.max(pdfContainer.clientWidth - 32, 200);
			for (let n = 1; n <= pdf.numPages; n++) {
				const page = await pdf.getPage(n);
				const base = page.getViewport({ scale: 1 });
				const scale = Math.min(w / base.width, 3);
				const vp = page.getViewport({ scale });
				const dpr = window.devicePixelRatio || 1;
				const canvas = document.createElement('canvas');
				canvas.width  = Math.floor(vp.width  * dpr);
				canvas.height = Math.floor(vp.height * dpr);
				canvas.style.width    = `${vp.width}px`;
				canvas.style.height   = `${vp.height}px`;
				canvas.style.minWidth  = '0';
				canvas.className = 'shadow-md';
				pdfContainer.appendChild(canvas);
				pdfPages.push({ el: canvas, w: vp.width, h: vp.height });
				const ctx = canvas.getContext('2d')!;
				ctx.scale(dpr, dpr);
				await page.render({ canvasContext: ctx, viewport: vp }).promise;
			}
			pdfStatus.textContent = `${pdf.numPages} page${pdf.numPages > 1 ? 's' : ''}`;
		} catch (err: any) {
			if (err?.name !== 'RenderingCancelledException') {
				console.error('[pdfjs]', err);
				pdfStatus.textContent = 'Erreur';
				pdfContainer.innerHTML = `<p class="p-4 text-red-500">Impossible de charger le PDF.<br><code class="text-xs">${err?.message ?? err}</code></p>`;
			}
		}
	}

	function closePdf() {
		pdfOverlay.style.display = 'none';
		pdfContainer.innerHTML = '';
		pdfPages.length = 0;
		if (pdfLoadingTask) { pdfLoadingTask.destroy(); pdfLoadingTask = null; }
		document.body.style.overflow = '';
	}
	document.getElementById('btn-close-pdf')!.addEventListener('click', closePdf);
	pdfOverlay.addEventListener('click', (e) => { if (e.target === pdfOverlay) closePdf(); });

	const pdfPicker = document.getElementById('pdf-picker') as HTMLElement;

	function showPdfPicker(btn: HTMLElement, pdfs: Array<{label: string, url: string}>) {
		pdfPicker.innerHTML = pdfs.map(p =>
			`<button class="pdf-picker-item block w-full truncate rounded px-3 py-1.5 text-left text-sm text-stone-700 hover:bg-blue-50 hover:text-blue-800" data-url="${p.url}">${p.label}</button>`
		).join('');
		const rect = btn.getBoundingClientRect();
		pdfPicker.style.top = `${rect.bottom + 4}px`;
		pdfPicker.style.left = `${rect.left}px`;
		pdfPicker.style.display = 'block';
	}

	pdfPicker.addEventListener('click', (e) => {
		const item = (e.target as HTMLElement).closest<HTMLButtonElement>('.pdf-picker-item');
		if (item) {
			pdfPicker.style.display = 'none';
			openPdf(item.dataset.url!);
		}
	});

	document.addEventListener('click', (e) => {
		if (!pdfPicker.contains(e.target as Node)) {
			pdfPicker.style.display = 'none';
		}
	});

	// ── Boutons voix dans la modale ───────────────────────────
	document.getElementById('modal-detail')!.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.agenda-audio-btn');
		if (btn) {
			e.stopPropagation();
			const url = btn.dataset.audioUrl!;
			const isExternal = btn.dataset.isExternal === 'true';
			if (isExternal) {
				const id = getYouTubeId(url);
				if (id) { videoQueue = [{id, title: btn.dataset.songTitle || ''}]; queueIndex = 0; showOverlayAndPlay(); }
				else window.open(url, '_blank', 'noopener');
				return;
			}
			if (currentModalAudioBtn === btn && !modalAudio.paused) {
				modalAudio.pause();
				btn.classList.remove('ring-2', 'ring-blue-700', 'ring-offset-1');
				currentModalAudioBtn = null;
			} else {
				if (currentModalAudioBtn) currentModalAudioBtn.classList.remove('ring-2', 'ring-blue-700', 'ring-offset-1');
				modalAudio.src = url;
				modalAudio.play();
				btn.classList.add('ring-2', 'ring-blue-700', 'ring-offset-1');
				currentModalAudioBtn = btn;
			}
			return;
		}
	});
	modalAudio.addEventListener('ended', () => {
		if (currentModalAudioBtn) { currentModalAudioBtn.classList.remove('ring-2', 'ring-blue-700', 'ring-offset-1'); currentModalAudioBtn = null; }
	});

	document.getElementById('detail-voice-btns')!.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.voice-playlist-btn');
		if (!btn) return;
		const voice = btn.dataset.voice!;
		const queue: Array<{id: string; title: string}> = [];
		document.querySelectorAll<HTMLButtonElement>(`#detail-program .agenda-audio-btn[data-voice="${voice}"]`).forEach(ab => {
			if (ab.dataset.isExternal === 'true') {
				const id = getYouTubeId(ab.dataset.audioUrl!);
				if (id) queue.push({id, title: ab.dataset.songTitle || ''});
			}
		});
		if (!queue.length) return;
		videoQueue = queue;
		queueIndex = 0;
		showOverlayAndPlay();
	});

	document.getElementById('modal-detail')!.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.agenda-pdf-btn');
		if (btn) {
			e.stopPropagation();
			const pdfsRaw = btn.dataset.pdfs;
			if (pdfsRaw) {
				showPdfPicker(btn, JSON.parse(pdfsRaw));
			} else {
				openPdf(btn.dataset.url!);
			}
		}
	});
</script>
