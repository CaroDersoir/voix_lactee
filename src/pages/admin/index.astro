function setStatus(id, type, msg) {
  const el = document.getElementById(id);
  el.className = `rounded-lg px-3 py-2 text-sm ${type === 'ok' ? 'bg-green-50 text-green-700' : type === 'loading' ? 'bg-blue-50 text-blue-700' : 'bg-red-50 text-red-600'}`;
  el.textContent = msg;
  el.classList.remove('hidden');
}

// Chants
let adminSongsCache = [];
let adminActiveFilter = '';

function applyAdminFilters() {
  const query = document.getElementById('admin-search').value.toLowerCase().trim();
  const rows = document.querySelectorAll('#songs-list [data-song-row]');
  let visible = 0;
  rows.forEach(row => {
    const titleMatch = row.dataset.title.includes(query);
    const filterMatch = !adminActiveFilter || (row.dataset.occasions || '').split(',').includes(adminActiveFilter);
    const show = titleMatch && filterMatch;
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('admin-no-results').classList.toggle('hidden', visible > 0);
}

async function loadSongs() {
  const list = document.getElementById('songs-list');
  list.innerHTML = '<p class="px-6 py-5 text-stone-400 italic">Chargement…</p>';
  const files = await ghGet('contents/src/content/songs');
  if (!Array.isArray(files)) { list.innerHTML = '<p class="px-6 py-5 text-red-400">Erreur (token invalide ?).</p>'; return; }
  const songs = await Promise.all(files.map(async f => {
    const d = await ghGet(`contents/${f.path}`);
    const md = b64decode(d.content);
    const bodyParts = md.split(/^---\s*$/m);
    return { path: f.path, sha: d.sha,
      title: parseYamlVal(md.match(/^title:\s*(.+)$/m)?.[1]) || f.name,
      key:   parseYamlVal(md.match(/^key:\s*(.+)$/m)?.[1]),
      occasions: parseOccasionStr(md.match(/^occasion:\s*(.+)$/m)?.[1]?.trim() || ''),
      pdf: md.match(/^pdf:\s*(.+)$/m)?.[1]?.trim() || '',
      pdfs: parsePdfsFromMd(md),
      audio_soprano: md.match(/^audio_soprano:\s*(.+)$/m)?.[1]?.trim() || '',
      audio_alto:    md.match(/^audio_alto:\s*(.+)$/m)?.[1]?.trim() || '',
      audio_tenor:   md.match(/^audio_tenor:\s*(.+)$/m)?.[1]?.trim() || '',
      audio_basse:   md.match(/^audio_basse:\s*(.+)$/m)?.[1]?.trim() || '',
      bodyContent: bodyParts.length >= 3 ? bodyParts.slice(2).join('---').trim() : '' };
  }));
  songs.sort((a, b) => a.title.localeCompare(b.title, 'fr'));
  adminSongsCache = songs;

  // Filtres par occasion
  const occasions = [...new Set(songs.flatMap(s => s.occasions).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'fr'));
  adminActiveFilter = '';
  const filtersEl = document.getElementById('admin-filters');
  filtersEl.innerHTML = ['', ...occasions].map((occ, i) => `
    <button data-occ="${occ}"
      class="admin-filter-btn rounded-full border px-2.5 py-0.5 text-xs font-medium transition-colors ${i === 0 ? 'border-blue-900 bg-blue-900 text-white' : 'border-stone-300 text-stone-600 hover:border-blue-900 hover:bg-blue-50 hover:text-blue-900'}">
      ${occ || 'Tous'}
    </button>`).join('');
  filtersEl.querySelectorAll('.admin-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      adminActiveFilter = btn.dataset.occ;
      filtersEl.querySelectorAll('.admin-filter-btn').forEach(b => {
        const on = b === btn;
        b.classList.toggle('bg-blue-900', on); b.classList.toggle('text-white', on); b.classList.toggle('border-blue-900', on);
        b.classList.toggle('text-stone-600', !on); b.classList.toggle('border-stone-300', !on);
      });
      applyAdminFilters();
    });
  });

  list.innerHTML = songs.length ? songs.map(s => `
    <div data-song-row data-title="${s.title.toLowerCase()}" data-occasions="${s.occasions.join(',')}"
      class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 hover:bg-stone-50 sm:px-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-medium text-stone-900">${s.title}</span>
        ${s.key ? `<span class="text-xs text-stone-400">${s.key}</span>` : ''}
        ${s.occasions.map(o => `<span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-500">${o}</span>`).join('')}
      </div>
      <div class="ml-4 flex flex-shrink-0 items-center gap-3">
        <button data-idx="${songs.indexOf(s)}"
          class="btn-mod-song text-xs font-medium text-blue-600 hover:text-blue-800 transition-colors">Modifier</button>
        <button data-path="${s.path}" data-sha="${s.sha}" data-name="${s.title}"
          class="btn-del-song text-xs font-medium text-red-400 hover:text-red-600 transition-colors">Supprimer</button>
      </div>
    </div>`).join('') : '<p class="px-6 py-5 text-stone-400 italic">Aucun chant.</p>';

  list.querySelectorAll('.btn-mod-song').forEach(btn => {
    btn.addEventListener('click', () => openEditModal(adminSongsCache[parseInt(btn.dataset.idx)]));
  });

  list.querySelectorAll('.btn-del-song').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm(`Supprimer définitivement "${btn.dataset.name}" ?`)) return;
      btn.textContent = '…'; btn.disabled = true;
      if (await ghDelete(btn.dataset.path, btn.dataset.sha, `suppr: ${btn.dataset.name}`)) { loadSongs(); triggerRebuild(); }
      else { btn.textContent = 'Erreur'; btn.disabled = false; }
    });
  });

  document.getElementById('admin-search').addEventListener('input', applyAdminFilters);
}

document.getElementById('form-add-song').addEventListener('submit', async e => {
  e.preventDefault();
  const title = document.getElementById('song-title').value.trim();
  const key = document.getElementById('song-key').value.trim();
  const occasions = getCheckedOccasions('song-occasions');
  if (!occasions.length) { setStatus('song-status', 'error', 'Veuillez choisir au moins un type de chant.'); return; }
  const normalTitle = t => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, ' ').trim();
  const duplicate = adminSongsCache.find(s => normalTitle(s.title) === normalTitle(title));
  if (duplicate) {
    const newOccs = occasions.filter(o => !duplicate.occasions.includes(o));
    if (!newOccs.length) { setStatus('song-status', 'error', `« ${duplicate.title} » existe déjà avec ces occasions.`); return; }
    const msg = `« ${duplicate.title} » existe déjà (${duplicate.occasions.join(', ')}). Ajouter l'occasion « ${newOccs.join(', ')} » à ce chant ?`;
    if (confirm(msg)) {
      setStatus('song-status', 'loading', 'Mise à jour des occasions…');
      try {
        const d = await ghGet(`contents/${duplicate.path}`);
        const md = b64decode(d.content);
        const merged = [...new Set([...duplicate.occasions, ...newOccs])];
        const newMd = md.replace(/^occasion:\s*.+$/m, `occasion: ${formatOccasionYaml(merged)}`);
        await ghPut(duplicate.path, b64encode(newMd), `tag: ${duplicate.title} +${newOccs.join(', ')}`, d.sha);
        setStatus('song-status', 'ok', `✓ Occasions mises à jour. Mise à jour dans ~2 min.`);
        e.target.reset(); buildOccasionCheckboxes('song-occasions', []); loadSongs(); triggerRebuild();
      } catch(err) { setStatus('song-status', 'error', 'Erreur : ' + err.message); }
      return;
    }
  }
  setStatus('song-status', 'loading', 'Enregistrement en cours…');
  try {
    const slug = slugify(title);
    const pdfEntries = [...document.getElementById('song-pdfs-list').querySelectorAll('.pdf-entry')];
    const uploadedPdfs = [];
    for (const entry of pdfEntries) {
      const labelVal = entry.querySelector('.pdf-label').value.trim();
      const file = entry.querySelector('.pdf-file')?.files?.[0];
      if (file) {
        const suffix = pdfEntries.length > 1 && labelVal ? `-${slugify(labelVal)}` : '';
        const uploadPath = `uploads/${slug}${suffix}.pdf`;
        await ghPut(`public/${uploadPath}`, await fileToBase64(file), `ajout partition: ${title}${labelVal ? ' (' + labelVal + ')' : ''}`);
        uploadedPdfs.push({ label: labelVal, url: uploadPath });
      }
    }
    let pdfPath = uploadedPdfs.length > 0 ? uploadedPdfs[0].url : '';
    const audioVoices = [
      { id: 'song-audio-s', urlId: 'song-audio-s-url', field: 'audio_soprano', suffix: '-soprano' },
      { id: 'song-audio-a', urlId: 'song-audio-a-url', field: 'audio_alto',    suffix: '-alto'    },
      { id: 'song-audio-t', urlId: 'song-audio-t-url', field: 'audio_tenor',   suffix: '-tenor'   },
      { id: 'song-audio-b', urlId: 'song-audio-b-url', field: 'audio_basse',   suffix: '-basse'   },
    ];
    const audioPaths = {};
    for (const v of audioVoices) {
      const file = document.getElementById(v.id).files?.[0];
      const url = document.getElementById(v.urlId).value.trim();
      if (file) {
        const ext = file.name.split('.').pop() || 'mp3';
        await ghPut(`public/uploads/${slug}${v.suffix}.${ext}`, await fileToBase64(file), `ajout audio ${v.field}: ${title}`);
        audioPaths[v.field] = `uploads/${slug}${v.suffix}.${ext}`;
      } else if (url) {
        audioPaths[v.field] = url;
      }
    }
    const pdfsYaml = uploadedPdfs.length > 1
      ? `pdfs:\n${uploadedPdfs.map(p => `  - label: ${yamlStr(p.label || 'Partition')}\n    url: ${p.url}`).join('\n')}`
      : null;
    const mdLines = ['---', `title: ${yamlStr(title)}`, key ? `key: ${yamlStr(key)}` : null,
      `occasion: ${formatOccasionYaml(occasions)}`,
      pdfPath ? `pdf: ${pdfPath}` : null,
      pdfsYaml,
      audioPaths.audio_soprano ? `audio_soprano: ${yamlStr(audioPaths.audio_soprano)}` : null,
      audioPaths.audio_alto    ? `audio_alto: ${yamlStr(audioPaths.audio_alto)}`       : null,
      audioPaths.audio_tenor   ? `audio_tenor: ${yamlStr(audioPaths.audio_tenor)}`     : null,
      audioPaths.audio_basse   ? `audio_basse: ${yamlStr(audioPaths.audio_basse)}`     : null,
      '---', ''].filter(l => l !== null).join('\n');
    await ghPut(`src/content/songs/${slug}.md`, b64encode(mdLines), `ajout chant: ${title}`);
    setStatus('song-status', 'ok', '✓ Ajouté. Mise à jour du site dans ~2 min.');
    e.target.reset(); buildOccasionCheckboxes('song-occasions', []);
    const songPdfsList2 = document.getElementById('song-pdfs-list'); songPdfsList2.innerHTML = ''; addPdfEntry(songPdfsList2);
    loadSongs(); triggerRebuild();
  } catch(err) { setStatus('song-status', 'error', 'Erreur : ' + err.message); }
});

// ── Modale édition chant ───────────────────────────────────
const editModal = document.getElementById('modal-edit-song');
let currentEditSong = null;

function openEditModal(song) {
  currentEditSong = song;
  document.getElementById('edit-path').value = song.path;
  document.getElementById('edit-sha').value = song.sha;
  document.getElementById('edit-body-content').value = song.bodyContent || '';
  document.getElementById('edit-title').value = song.title;
  document.getElementById('edit-key').value = song.key;
  buildOccasionCheckboxes('edit-occasions', song.occasions);
  const editPdfsList = document.getElementById('edit-pdfs-list');
  editPdfsList.innerHTML = '';
  if (song.pdfs && song.pdfs.length > 0) {
    song.pdfs.forEach(p => addPdfEntry(editPdfsList, { label: p.label, existingUrl: p.url }));
  } else if (song.pdf) {
    addPdfEntry(editPdfsList, { label: '', existingUrl: song.pdf });
  } else {
    addPdfEntry(editPdfsList);
  }
  document.getElementById('edit-audio-s-url').value = song.audio_soprano || '';
  document.getElementById('edit-audio-a-url').value = song.audio_alto || '';
  document.getElementById('edit-audio-t-url').value = song.audio_tenor || '';
  document.getElementById('edit-audio-b-url').value = song.audio_basse || '';
  ['edit-audio-s','edit-audio-a','edit-audio-t','edit-audio-b'].forEach(id => { document.getElementById(id).value = ''; });
  document.getElementById('edit-status').classList.add('hidden');
  editModal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeEditModal() {
  editModal.style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('btn-close-edit-modal').addEventListener('click', closeEditModal);
document.getElementById('btn-cancel-edit').addEventListener('click', closeEditModal);
editModal.addEventListener('click', e => { if (e.target === editModal) closeEditModal(); });

document.getElementById('form-edit-song').addEventListener('submit', async e => {
  e.preventDefault();
  const path        = document.getElementById('edit-path').value;
  const sha         = document.getElementById('edit-sha').value;
  const title       = document.getElementById('edit-title').value.trim();
  const key         = document.getElementById('edit-key').value.trim();
  const occasions   = getCheckedOccasions('edit-occasions');
  const bodyContent = document.getElementById('edit-body-content').value;
  if (!title || !occasions.length) { setStatus('edit-status', 'error', 'Titre et au moins un type obligatoires.'); return; }
  setStatus('edit-status', 'loading', 'Enregistrement en cours…');
  try {
    const editPdfEntries = [...document.getElementById('edit-pdfs-list').querySelectorAll('.pdf-entry')];
    const editedPdfs = [];
    for (const entry of editPdfEntries) {
      const labelVal = entry.querySelector('.pdf-label').value.trim();
      const existingUrl = entry.dataset.existingUrl || '';
      const file = entry.querySelector('.pdf-file')?.files?.[0];
      if (file) {
        const suffix = editPdfEntries.length > 1 && labelVal ? `-${slugify(labelVal)}` : '';
        const newPath = `uploads/${slugify(title)}${suffix}.pdf`;
        await ghPut(`public/${newPath}`, await fileToBase64(file), `partition: ${title}${labelVal ? ' (' + labelVal + ')' : ''}`);
        editedPdfs.push({ label: labelVal, url: newPath });
      } else if (existingUrl) {
        editedPdfs.push({ label: labelVal, url: existingUrl });
      }
    }
    let pdfPath = editedPdfs.length > 0 ? editedPdfs[0].url : '';
    const editAudioVoices = [
      { fileId: 'edit-audio-s', urlId: 'edit-audio-s-url', field: 'audio_soprano', suffix: '-soprano' },
      { fileId: 'edit-audio-a', urlId: 'edit-audio-a-url', field: 'audio_alto',    suffix: '-alto'    },
      { fileId: 'edit-audio-t', urlId: 'edit-audio-t-url', field: 'audio_tenor',   suffix: '-tenor'   },
      { fileId: 'edit-audio-b', urlId: 'edit-audio-b-url', field: 'audio_basse',   suffix: '-basse'   },
    ];
    const audioFields = {};
    for (const v of editAudioVoices) {
      const file = document.getElementById(v.fileId).files?.[0];
      const urlVal = document.getElementById(v.urlId).value.trim();
      if (file) {
        const ext = file.name.split('.').pop() || 'mp3';
        await ghPut(`public/uploads/${slugify(title)}${v.suffix}.${ext}`, await fileToBase64(file), `audio ${v.field}: ${title}`);
        audioFields[v.field] = `uploads/${slugify(title)}${v.suffix}.${ext}`;
      } else {
        audioFields[v.field] = urlVal;
      }
    }
    const editPdfsYaml = editedPdfs.length > 1
      ? `pdfs:\n${editedPdfs.map(p => `  - label: ${yamlStr(p.label || 'Partition')}\n    url: ${p.url}`).join('\n')}`
      : null;
    const md = ['---', `title: ${yamlStr(title)}`, key ? `key: ${yamlStr(key)}` : null,
      `occasion: ${formatOccasionYaml(occasions)}`, pdfPath ? `pdf: ${pdfPath}` : null, editPdfsYaml,
      audioFields.audio_soprano ? `audio_soprano: ${yamlStr(audioFields.audio_soprano)}` : null,
      audioFields.audio_alto    ? `audio_alto: ${yamlStr(audioFields.audio_alto)}`       : null,
      audioFields.audio_tenor   ? `audio_tenor: ${yamlStr(audioFields.audio_tenor)}`     : null,
      audioFields.audio_basse   ? `audio_basse: ${yamlStr(audioFields.audio_basse)}`     : null,
      '---', bodyContent || ''].filter(l => l !== null).join('\n');
    await ghPut(path, b64encode(md), `modif chant: ${title}`, sha);
    setStatus('edit-status', 'ok', '✓ Modifié. Mise à jour dans ~2 min.');
    setTimeout(() => { closeEditModal(); loadSongs(); triggerRebuild(); }, 1200);
  } catch(err) { setStatus('edit-status', 'error', 'Erreur : ' + err.message); }
});

// ── Événements ────────────────────────────────────────────────
let adminEvtsCache = [];

function updateSlotPdfsArea(sel, slotRow) {
  const pdfsArea = slotRow.querySelector('.slot-pdfs-area');
  const pdfsList = slotRow.querySelector('.slot-pdfs-list');
  const pdfPath = sel.value;
  if (!pdfPath || pdfPath === '__autre__') { pdfsArea.classList.add('hidden'); return; }
  const song = adminSongsCache.find(s => s.pdf === pdfPath || (s.pdfs && s.pdfs.some(p => p.url === pdfPath)));
  if (!song) { pdfsArea.classList.add('hidden'); return; }
  const pdfs = song.pdfs && song.pdfs.length > 1 ? song.pdfs : (song.pdf ? [{ label: '', url: song.pdf }] : []);
  pdfsList.innerHTML = pdfs.map(p =>
    `<span class="inline-flex items-center gap-1 rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">
      ${p.label ? `<span class="font-medium">${p.label}</span> — ` : ''}<span class="text-stone-400">${p.url.split('/').pop()}</span>
    </span>`).join('');
  pdfsArea.classList.remove('hidden');
}

function buildProgramSlots(container, currentProgram, type) {
  const slots = slotsForType(type || 'messe');
  container.innerHTML = slots.map(slot => {
    const isEnPlus = slot.key === 'en_plus' || slot.key === 'en_plus_2' || slot.key === 'en_plus_3';
    const songs = adminSongsCache.filter(s => (isEnPlus || s.occasions.includes(slot.occasion)) && s.pdf).sort((a, b) => a.title.localeCompare(b.title, 'fr'));
    const cur = (currentProgram || {})[slot.key] || '';
    const opts = songs.map(s => `<option value="${s.pdf}"${s.pdf === cur ? ' selected' : ''}>${s.title}</option>`).join('');
    return `<div class="slot-row space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="w-full text-xs font-medium text-stone-600 sm:w-36 sm:flex-shrink-0">${slot.label}</span>
        <select class="slot-select min-w-0 flex-1 rounded-lg border border-stone-300 px-2 py-1.5 text-xs focus:border-blue-700 focus:outline-none" data-slot="${slot.key}" data-occasion="${slot.occasion}" data-label="${slot.label}">
          <option value="">-- Aucun --</option>${opts}
          <option value="__autre__">⊕ Chercher un autre chant…</option>
        </select>
        <label class="flex-shrink-0 cursor-pointer rounded border border-stone-300 px-2 py-1 text-xs text-stone-500 hover:border-blue-600 hover:text-blue-700 transition-colors">
          Importer
          <input type="file" accept=".pdf" class="slot-file hidden" data-slot="${slot.key}" data-occasion="${slot.occasion}" data-label="${slot.label}" />
        </label>
        <span class="slot-status w-4 flex-shrink-0 text-xs text-stone-400" data-slot="${slot.key}"></span>
      </div>
      <div class="slot-pdfs-area ml-0 hidden sm:ml-36">
        <div class="slot-pdfs-list mb-1 flex flex-wrap gap-1"></div>
        <label class="inline-flex cursor-pointer items-center gap-1 rounded border border-dashed border-stone-300 px-2 py-0.5 text-xs text-stone-400 hover:border-blue-500 hover:text-blue-600 transition-colors">
          + partition
          <input type="file" accept=".pdf" class="slot-add-pdf hidden" data-slot="${slot.key}" />
        </label>
      </div>
    </div>`;
  }).join('');

  container.querySelectorAll('.slot-file').forEach(input => {
    input.addEventListener('change', async () => {
      const file = input.files[0]; if (!file) return;
      const title = prompt(`Titre du chant (${input.dataset.label}) :`, file.name.replace(/\.pdf$/i, ''));
      if (!title) { input.value = ''; return; }
      const statusEl = container.querySelector(`.slot-status[data-slot="${input.dataset.slot}"]`);
      const normalTitle = t => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, ' ').trim();
      const duplicate = adminSongsCache.find(s => normalTitle(s.title) === normalTitle(title));
      if (duplicate) {
        const alreadyHasOcc = duplicate.occasions.includes(input.dataset.occasion);
        const msg = alreadyHasOcc
          ? `« ${duplicate.title} » existe déjà dans le répertoire avec l'occasion « ${input.dataset.occasion} ». Utiliser ce chant existant ?`
          : `« ${duplicate.title} » existe déjà (${duplicate.occasions.join(', ')}). Ajouter l'occasion « ${input.dataset.occasion} » et utiliser ce chant existant ?`;
        if (confirm(msg)) {
          statusEl.textContent = '…';
          try {
            if (!alreadyHasOcc) {
              const d = await ghGet(`contents/${duplicate.path}`);
              const md = b64decode(d.content);
              const merged = [...new Set([...duplicate.occasions, input.dataset.occasion])];
              const newMd = md.replace(/^occasion:\s*.+$/m, `occasion: ${formatOccasionYaml(merged)}`);
              await ghPut(duplicate.path, b64encode(newMd), `tag: ${duplicate.title} +${input.dataset.occasion}`, d.sha);
            }
            const sel = container.querySelector(`.slot-select[data-slot="${input.dataset.slot}"]`);
            const existing = sel.querySelector(`option[value="${duplicate.pdf}"]`);
            if (existing) { existing.selected = true; }
            else if (duplicate.pdf) { sel.appendChild(new Option(duplicate.title, duplicate.pdf, true, true)); }
            statusEl.textContent = '✓';
            const slotRow = input.closest('.slot-row');
            if (slotRow) updateSlotPdfsArea(sel, slotRow);
            loadSongs(); if (!alreadyHasOcc) triggerRebuild();
          } catch { statusEl.textContent = '✗'; }
          input.value = '';
          return;
        }
      }
      statusEl.textContent = '…';
      try {
        const pdfPath = `uploads/${slugify(title)}.pdf`;
        await ghPut(`public/${pdfPath}`, await fileToBase64(file), `partition: ${title}`);
        const songMd = ['---', `title: ${yamlStr(title)}`, `occasion: ${yamlStr(input.dataset.occasion)}`, `pdf: ${pdfPath}`, '---', ''].join('\n');
        await ghPut(`src/content/songs/${slugify(title)}.md`, b64encode(songMd), `ajout chant: ${title}`);
        const sel = container.querySelector(`.slot-select[data-slot="${input.dataset.slot}"]`);
        const opt = new Option(title, pdfPath, true, true);
        sel.appendChild(opt);
        statusEl.textContent = '✓';
        const slotRow = input.closest('.slot-row');
        if (slotRow) updateSlotPdfsArea(sel, slotRow);
        loadSongs(); triggerRebuild();
      } catch { statusEl.textContent = '✗'; }
    });
  });

  container.querySelectorAll('.slot-select').forEach(sel => {
    const slotRow = sel.closest('.slot-row');
    sel.addEventListener('change', () => {
      if (sel.value === '__autre__') {
        sel.value = '';
        openSongPicker(sel.dataset.slot, sel.dataset.occasion, sel.dataset.label, container);
      }
      if (slotRow) updateSlotPdfsArea(sel, slotRow);
    });
    if (sel.value && slotRow) updateSlotPdfsArea(sel, slotRow);
  });

  container.querySelectorAll('.slot-add-pdf').forEach(input => {
    input.addEventListener('change', async () => {
      const file = input.files[0]; if (!file) return;
      const slotRow = input.closest('.slot-row');
      const sel = slotRow.querySelector('.slot-select');
      const statusEl = slotRow.querySelector('.slot-status');
      const pdfPath = sel.value;
      if (!pdfPath) { input.value = ''; return; }
      const song = adminSongsCache.find(s => s.pdf === pdfPath);
      if (!song) { input.value = ''; return; }
      const label = prompt(`Libellé de la nouvelle partition pour « ${song.title} » (ex. : Guitare, Orgue, 4 voix…) :`, '');
      if (label === null) { input.value = ''; return; }
      statusEl.textContent = '…';
      try {
        const suffix = label ? `-${slugify(label)}` : `-extra${Date.now()}`;
        const uploadPath = `uploads/${slugify(song.title)}${suffix}.pdf`;
        await ghPut(`public/${uploadPath}`, await fileToBase64(file), `partition: ${song.title} (${label || 'extra'})`);
        const d = await ghGet(`contents/${song.path}`);
        const md = b64decode(d.content);
        const existingPdfs = song.pdfs && song.pdfs.length > 0
          ? song.pdfs.map(p => ({ label: p.label || 'Partition', url: p.url }))
          : [{ label: 'Partition', url: song.pdf }];
        const updatedPdfs = [...existingPdfs, { label: label || 'Partition', url: uploadPath }];
        const pdfsYaml = `pdfs:\n${updatedPdfs.map(p => `  - label: ${yamlStr(p.label)}\n    url: ${p.url}`).join('\n')}`;
        const parts = md.split(/^---$/m);
        let fm = parts.length >= 3 ? parts[1] : '\n';
        fm = fm.replace(/^pdfs:\n(?:  .*\n)*/m, '');
        if (fm.match(/^pdf:\s*.+$/m)) {
          fm = fm.replace(/^(pdf:\s*.+)$/m, `$1\n${pdfsYaml}`);
        } else {
          fm = fm.trimEnd() + '\n' + pdfsYaml + '\n';
        }
        const newMd = `---${fm}---\n${parts.slice(2).join('---')}`;
        await ghPut(song.path, b64encode(newMd), `partition: ${song.title} +${label || 'extra'}`, d.sha);
        statusEl.textContent = '✓';
        setTimeout(() => { if (statusEl.textContent === '✓') statusEl.textContent = ''; }, 2000);
        await loadSongs();
        updateSlotPdfsArea(sel, slotRow);
        triggerRebuild();
      } catch(err) { statusEl.textContent = '✗'; console.error(err); }
      input.value = '';
    });
  });
}

// Wizard ajout événement
let evtStep = 1;
function showEvtStep(n) {
  evtStep = n;
  [1, 2, 3].forEach(i => document.getElementById('evt-step-' + i).classList.toggle('hidden', i !== n));
  document.getElementById('evt-ind-sep1').classList.toggle('hidden', n < 2);
  document.getElementById('evt-ind-2').classList.toggle('hidden', n < 2);
  document.getElementById('evt-ind-sep2').classList.toggle('hidden', n < 3);
  document.getElementById('evt-ind-3').classList.toggle('hidden', n < 3);
  ['evt-ind-1','evt-ind-2','evt-ind-3'].forEach((id, i) => {
    const el = document.getElementById(id);
    if (el) { el.classList.toggle('font-semibold', n === i + 1); el.classList.toggle('text-blue-900', n >= i + 1); el.classList.toggle('text-stone-400', n < i + 1); }
  });
}

document.getElementById('evt-btn-next1').addEventListener('click', () => {
  const title = document.getElementById('evt-title').value.trim();
  const date  = document.getElementById('evt-date').value;
  const time  = document.getElementById('evt-time').value;
  const loc   = document.getElementById('evt-location').value.trim();
