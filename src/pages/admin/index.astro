---
import '../../styles/global.css';
const GH_TOKEN = import.meta.env.GH_TOKEN ?? '';
const NETLIFY_BUILD_HOOK = import.meta.env.NETLIFY_BUILD_HOOK ?? '';
const base = import.meta.env.DEV
  ? '/'
  : import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Administration — Voix Lactée</title>
</head>
<body class="bg-stone-50 text-stone-800" style="font-family: system-ui, sans-serif;">

<div id="screen-login" class="flex min-h-screen items-center justify-center p-4">
  <div class="w-full max-w-sm rounded-xl border border-stone-200 bg-white p-8 shadow-sm">
    <h1 class="mb-1 text-xl font-semibold text-blue-950">Voix Lactée</h1>
    <p class="mb-6 text-sm text-stone-500">Interface d'administration</p>
    <form id="form-login" class="space-y-4">
      <div>
        <label class="mb-1 block text-sm font-medium text-stone-700">Identifiant</label>
        <input id="login-user" type="text" required autocomplete="username"
          class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-stone-700">Mot de passe</label>
        <input id="login-pass" type="password" required autocomplete="current-password"
          class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
      </div>
      <p id="login-error" class="hidden text-sm text-red-500">Identifiant ou mot de passe incorrect.</p>
      <button type="submit"
        class="w-full rounded-lg bg-blue-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-800">
        Se connecter
      </button>
    </form>
  </div>
</div>

<div id="screen-admin" class="hidden min-h-screen" style="display:none">

  <header class="border-b border-stone-200 bg-white px-6 py-4 flex items-center justify-between shadow-sm">
    <h1 class="text-base font-semibold text-blue-950">Administration — Voix Lactée</h1>
    <div class="flex items-center gap-4">
      <a id="btn-back-site" href={base}
        class="inline-flex items-center gap-1.5 text-sm text-stone-400 hover:text-blue-800 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
        </svg>
        Retour au site
      </a>
      <button id="btn-logout" class="text-sm text-stone-400 hover:text-stone-700 transition-colors">Déconnexion</button>
    </div>
  </header>

  <div class="border-b border-stone-200 bg-white px-6">
    <div class="flex gap-0">
      <button data-tab="songs"
        class="tab-btn border-b-2 border-blue-900 px-4 py-3 text-sm font-medium text-blue-900 transition-colors">
        Répertoire
      </button>
      <button data-tab="events"
        class="tab-btn border-b-2 border-transparent px-4 py-3 text-sm font-medium text-stone-500 transition-colors hover:text-stone-800">
        Agenda
      </button>
    </div>
  </div>

  <main class="mx-auto max-w-3xl space-y-6 p-6">

    <div id="tab-songs">
      <div class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-stone-500">Ajouter un chant</h2>
        <form id="form-add-song" class="space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="mb-1 block text-sm font-medium text-stone-700">Titre <span class="text-red-500">*</span></label>
              <input id="song-title" type="text" required
                class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium text-stone-700">Tonalité</label>
              <input id="song-key" type="text" placeholder="Ex. : Ré majeur"
                class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
            </div>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Type de chant <span class="text-red-500">*</span></label>
            <select id="song-occasion" required
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700">
              <option value="">-- Choisir --</option>
            </select>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Partition (PDF)</label>
            <input id="song-pdf" type="file" accept=".pdf"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm text-stone-700 file:mr-3 file:cursor-pointer file:rounded file:border-0 file:bg-blue-50 file:px-3 file:py-1 file:text-sm file:font-medium file:text-blue-800 hover:file:bg-blue-100" />
          </div>
          <div>
            <p class="mb-2 text-sm font-medium text-stone-700">Pistes audio (MP3)</p>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="mb-1 block text-xs text-stone-500">Soprano</label>
                <input id="song-audio-s" type="file" accept=".mp3,audio/*"
                  class="w-full rounded-lg border border-stone-300 px-2 py-1.5 text-xs text-stone-700 file:mr-2 file:cursor-pointer file:rounded file:border-0 file:bg-blue-50 file:px-2 file:py-0.5 file:text-xs file:font-medium file:text-blue-800 hover:file:bg-blue-100" />
              </div>
              <div>
                <label class="mb-1 block text-xs text-stone-500">Alto</label>
                <input id="song-audio-a" type="file" accept=".mp3,audio/*"
                  class="w-full rounded-lg border border-stone-300 px-2 py-1.5 text-xs text-stone-700 file:mr-2 file:cursor-pointer file:rounded file:border-0 file:bg-blue-50 file:px-2 file:py-0.5 file:text-xs file:font-medium file:text-blue-800 hover:file:bg-blue-100" />
              </div>
              <div>
                <label class="mb-1 block text-xs text-stone-500">Ténor</label>
                <input id="song-audio-t" type="file" accept=".mp3,audio/*"
                  class="w-full rounded-lg border border-stone-300 px-2 py-1.5 text-xs text-stone-700 file:mr-2 file:cursor-pointer file:rounded file:border-0 file:bg-blue-50 file:px-2 file:py-0.5 file:text-xs file:font-medium file:text-blue-800 hover:file:bg-blue-100" />
              </div>
              <div>
                <label class="mb-1 block text-xs text-stone-500">Basse</label>
                <input id="song-audio-b" type="file" accept=".mp3,audio/*"
                  class="w-full rounded-lg border border-stone-300 px-2 py-1.5 text-xs text-stone-700 file:mr-2 file:cursor-pointer file:rounded file:border-0 file:bg-blue-50 file:px-2 file:py-0.5 file:text-xs file:font-medium file:text-blue-800 hover:file:bg-blue-100" />
              </div>
            </div>
          </div>
          <div id="song-status" class="hidden rounded-lg px-3 py-2 text-sm"></div>
          <button type="submit"
            class="rounded-lg bg-blue-900 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-800">
            Ajouter le chant
          </button>
        </form>
      </div>
      <div class="rounded-xl border border-stone-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-stone-100 px-6 py-4">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-stone-500">Chants existants</h2>
          <div class="flex flex-wrap items-center gap-2">
            <input id="admin-search" type="search" placeholder="Rechercher…"
              class="flex-1 min-w-40 rounded-lg border border-stone-300 px-3 py-1.5 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
            <div id="admin-filters" class="flex flex-wrap gap-1.5"></div>
          </div>
        </div>
        <div id="songs-list" class="divide-y divide-stone-100 text-sm">
          <p class="px-6 py-5 text-stone-400 italic">Chargement…</p>
        </div>
        <p id="admin-no-results" class="hidden py-5 text-center text-sm text-stone-400">Aucun chant trouvé.</p>
      </div>
    </div>

    <div id="tab-events" class="hidden">
      <div class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-stone-500">Ajouter un événement</h2>

        <!-- Indicateur d'étapes -->
        <div id="evt-steps-ind" class="mb-5 flex items-center gap-1.5 text-xs">
          <span id="evt-ind-1" class="font-semibold text-blue-900">1. Infos</span>
          <span id="evt-ind-sep1" class="hidden text-stone-300">›</span>
          <span id="evt-ind-2" class="hidden text-stone-400">2. Programme</span>
          <span id="evt-ind-sep2" class="hidden text-stone-300">›</span>
          <span id="evt-ind-3" class="hidden text-stone-400">3. Équipe</span>
        </div>

        <!-- Étape 1 : Informations de base -->
        <div id="evt-step-1" class="space-y-4">
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Titre <span class="text-red-500">*</span></label>
            <input id="evt-title" type="text"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
          <div>
            <label class="mb-2 block text-sm font-medium text-stone-700">Type <span class="text-red-500">*</span></label>
            <div class="flex gap-5">
              <label class="flex cursor-pointer items-center gap-2">
                <input type="radio" name="evt-type" value="messe" checked class="accent-blue-700" />
                <span class="text-sm text-stone-700">Messe</span>
              </label>
              <label class="flex cursor-pointer items-center gap-2">
                <input type="radio" name="evt-type" value="autre" class="accent-blue-700" />
                <span class="text-sm text-stone-700">Autre</span>
              </label>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="mb-1 block text-sm font-medium text-stone-700">Date <span class="text-red-500">*</span></label>
              <input id="evt-date" type="date"
                class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium text-stone-700">Heure <span class="text-red-500">*</span></label>
              <input id="evt-time" type="time"
                class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
            </div>
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Lieu <span class="text-red-500">*</span></label>
            <input id="evt-location" type="text"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Description</label>
            <textarea id="evt-description" rows="2"
              class="w-full resize-none rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"></textarea>
          </div>
          <div id="evt-status-1" class="hidden rounded-lg px-3 py-2 text-sm"></div>
          <div class="flex justify-end">
            <button id="evt-btn-next1" type="button"
              class="rounded-lg bg-blue-900 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-800">Suivant →</button>
          </div>
        </div>

        <!-- Étape 2 : Programme (messe) -->
        <div id="evt-step-2" class="hidden space-y-3">
          <p class="text-xs text-stone-400">Choisir un chant du répertoire ou importer un PDF. Tout est optionnel et modifiable après coup.</p>
          <div id="evt-program-slots" class="space-y-2"></div>
          <div class="flex justify-between pt-2">
            <button id="evt-btn-back2" type="button"
              class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">← Retour</button>
            <button id="evt-btn-next2" type="button"
              class="rounded-lg bg-blue-900 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-800">Suivant →</button>
          </div>
        </div>

        <!-- Étape 3 : Équipe -->
        <div id="evt-step-3" class="hidden space-y-4">
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Animateur·ice</label>
            <input id="evt-animateur" type="text" placeholder="Prénom Nom"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Chef·fe de chœur</label>
            <input id="evt-chef-choeur" type="text" placeholder="Prénom Nom"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
          <div id="evt-status" class="hidden rounded-lg px-3 py-2 text-sm"></div>
          <div class="flex justify-between pt-2">
            <button id="evt-btn-back3" type="button"
              class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">← Retour</button>
            <button id="evt-btn-submit" type="button"
              class="rounded-lg bg-blue-900 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-800">Ajouter l'événement</button>
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-stone-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-stone-100 px-6 py-4">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-stone-500">Événements existants</h2>
        </div>
        <div id="events-list" class="divide-y divide-stone-100 text-sm">
          <p class="px-6 py-5 text-stone-400 italic">Chargement…</p>
        </div>
      </div>
    </div>

  </main>
</div>

<!-- ── Modale : modifier un chant ── -->
<div id="modal-edit-song" class="fixed inset-0 z-50 items-center justify-center bg-black/50 p-4" style="display:none;">
  <div class="w-full max-w-lg rounded-xl bg-white shadow-xl">
    <div class="flex items-center justify-between border-b border-stone-200 px-6 py-4">
      <h2 class="text-base font-semibold text-blue-950">Modifier le chant</h2>
      <button id="btn-close-edit-modal" class="rounded-full p-1 text-stone-400 hover:bg-stone-100 hover:text-stone-900 transition-colors" aria-label="Fermer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>
    <div class="px-6 py-5">
      <form id="form-edit-song" class="space-y-4">
        <input type="hidden" id="edit-path" />
        <input type="hidden" id="edit-sha" />
        <input type="hidden" id="edit-body-content" />
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Titre <span class="text-red-500">*</span></label>
            <input id="edit-title" type="text" required
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Tonalité</label>
            <input id="edit-key" type="text" placeholder="Ex. : Ré majeur"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-stone-700">Type de chant <span class="text-red-500">*</span></label>
          <select id="edit-occasion" required
            class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700">
            <option value="">-- Choisir --</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-stone-700">Remplacer la partition (PDF)</label>
          <p id="edit-current-pdf" class="mb-1 text-xs text-stone-400"></p>
          <input id="edit-pdf" type="file" accept=".pdf"
            class="w-full rounded-lg border border-stone-200 px-3 py-1.5 text-sm text-stone-600 file:mr-3 file:cursor-pointer file:rounded file:border-0 file:bg-blue-50 file:px-3 file:py-1 file:text-sm file:font-medium file:text-blue-800 hover:file:bg-blue-100" />
        </div>
        <div id="edit-status" class="hidden rounded-lg px-3 py-2 text-sm"></div>
      </form>
    </div>
    <div class="flex justify-end gap-3 border-t border-stone-200 px-6 py-4">
      <button type="button" id="btn-cancel-edit"
        class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50 transition-colors">Annuler</button>
      <button type="submit" form="form-edit-song"
        class="rounded-lg bg-blue-900 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 transition-colors">Enregistrer</button>
    </div>
  </div>
</div>

<!-- ── Modale : modifier un événement ── -->
<div id="modal-edit-event" class="fixed inset-0 z-50 items-center justify-center bg-black/50 p-4" style="display:none;">
  <div class="w-full max-w-2xl rounded-xl bg-white shadow-xl" style="max-height:90vh;overflow-y:auto;">
    <div class="flex items-center justify-between border-b border-stone-200 px-6 py-4">
      <h2 class="text-base font-semibold text-blue-950">Modifier l'événement</h2>
      <button id="btn-close-edit-event" class="rounded-full p-1 text-stone-400 hover:bg-stone-100 hover:text-stone-900 transition-colors" aria-label="Fermer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>
    <form id="form-edit-event">
      <div class="space-y-4 px-6 py-5">
        <input type="hidden" id="edit-evt-path" />
        <input type="hidden" id="edit-evt-sha" />
        <div>
          <label class="mb-1 block text-sm font-medium text-stone-700">Titre <span class="text-red-500">*</span></label>
          <input id="edit-evt-title" type="text" required
            class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium text-stone-700">Type</label>
          <div class="flex gap-5">
            <label class="flex cursor-pointer items-center gap-2">
              <input type="radio" name="edit-evt-type" value="messe" class="accent-blue-700" />
              <span class="text-sm text-stone-700">Messe</span>
            </label>
            <label class="flex cursor-pointer items-center gap-2">
              <input type="radio" name="edit-evt-type" value="autre" class="accent-blue-700" />
              <span class="text-sm text-stone-700">Autre</span>
            </label>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Date <span class="text-red-500">*</span></label>
            <input id="edit-evt-date" type="date" required
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Heure</label>
            <input id="edit-evt-time" type="time"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-stone-700">Lieu</label>
          <input id="edit-evt-location" type="text"
            class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-stone-700">Description</label>
          <textarea id="edit-evt-description" rows="2"
            class="w-full resize-none rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"></textarea>
        </div>
        <div id="edit-evt-program-section">
          <h3 class="mb-2 border-t border-stone-100 pt-3 text-sm font-semibold text-stone-600">Programme</h3>
          <div id="edit-evt-program-slots" class="space-y-2"></div>
        </div>
        <div class="grid grid-cols-2 gap-4 border-t border-stone-100 pt-3">
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Animateur·ice</label>
            <input id="edit-evt-animateur" type="text"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
          <div>
            <label class="mb-1 block text-sm font-medium text-stone-700">Chef·fe de chœur</label>
            <input id="edit-evt-chef-choeur" type="text"
              class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" />
          </div>
        </div>
        <div id="edit-evt-status" class="hidden rounded-lg px-3 py-2 text-sm"></div>
      </div>
      <div class="flex justify-end gap-3 border-t border-stone-200 px-6 py-4">
        <button type="button" id="btn-cancel-edit-event"
          class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50 transition-colors">Annuler</button>
        <button type="submit"
          class="rounded-lg bg-blue-900 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 transition-colors">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ GH_TOKEN, NETLIFY_BUILD_HOOK }}>
const OWNER  = 'CaroDersoir';
async function triggerRebuild() { if (NETLIFY_BUILD_HOOK) fetch(NETLIFY_BUILD_HOOK, { method: 'POST' }); }
const REPO   = 'voix_lactee';
const BRANCH = 'main';
const TOKEN  = GH_TOKEN;
const CREDS  = { user: 'admin', pass: 'jcroispasnon' };
const SESSION_KEY = 'vl_admin_ok';
const OCCASION_OPTIONS = ['Accueil','Kyrie','Gloria','Psaume','Alléluia','Prière universelle','Offertoire','Sanctus','Agnus Dei','Communion','Action de grâce','Envoi','En plus','Autre'];
const MASS_SLOTS = [
  { key: 'accueil',            label: 'Accueil',            occasion: 'Accueil' },
  { key: 'kyrie',              label: 'Kyrie',              occasion: 'Kyrie' },
  { key: 'gloria',             label: 'Gloria',             occasion: 'Gloria' },
  { key: 'psaume',             label: 'Psaume',             occasion: 'Psaume' },
  { key: 'alleluia',           label: 'Alléluia',           occasion: 'Alléluia' },
  { key: 'priere_universelle', label: 'Prière universelle', occasion: 'Prière universelle' },
  { key: 'offertoire',         label: 'Offertoire',         occasion: 'Offertoire' },
  { key: 'sanctus',            label: 'Sanctus',            occasion: 'Sanctus' },
  { key: 'agnus',              label: 'Agnus Dei',          occasion: 'Agnus Dei' },
  { key: 'communion',          label: 'Communion',          occasion: 'Communion' },
  { key: 'action_grace',       label: 'Action de grâce',   occasion: 'Action de grâce' },
  { key: 'envoi',              label: 'Envoi',              occasion: 'Envoi' },
  { key: 'en_plus',            label: 'En plus',            occasion: 'En plus' },
];

function buildOccasionSelect(selectEl, current) {
  selectEl.innerHTML = '<option value="">-- Choisir --</option>' +
    OCCASION_OPTIONS.map(o => `<option${o === current ? ' selected' : ''}>${o}</option>`).join('');
}
buildOccasionSelect(document.getElementById('song-occasion'), '');

function b64decode(str) {
  const binary = atob(str.replace(/\n/g, ''));
  return new TextDecoder().decode(Uint8Array.from(binary, c => c.charCodeAt(0)));
}
function b64encode(str) {
  const bytes = new TextEncoder().encode(str);
  return btoa(String.fromCharCode(...bytes));
}
function slugify(str) {
  return str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
function yamlStr(val) {
  return /[:#\[\]{},|>&*!'"\\]/.test(val) || val.includes('\n') ? JSON.stringify(val) : val;
}

const GH = { Authorization: `Bearer ${TOKEN}`, 'Content-Type': 'application/json', Accept: 'application/vnd.github+json' };

async function ghGet(path) {
  const r = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/${path}`, { headers: GH });
  const data = await r.json();
  if (!r.ok) console.error('GitHub API error', r.status, data.message, '| token present:', !!TOKEN);
  return data;
}
async function ghPut(path, content, msg, sha)   {
  const body = { message: msg, content, branch: BRANCH };
  if (sha) body.sha = sha;
  return fetch(`https://api.github.com/repos/${OWNER}/${REPO}/contents/${path}`, { method: 'PUT', headers: GH, body: JSON.stringify(body) }).then(r => r.json());
}
async function ghDelete(path, sha, msg)         { return fetch(`https://api.github.com/repos/${OWNER}/${REPO}/contents/${path}`, { method: 'DELETE', headers: GH, body: JSON.stringify({ message: msg, sha, branch: BRANCH }) }).then(r => r.ok); }
async function fileToBase64(file)               { return new Promise(res => { const r = new FileReader(); r.onload = e => res(e.target.result.split(',')[1]); r.readAsDataURL(file); }); }

// Auth
document.getElementById('form-login').addEventListener('submit', e => {
  e.preventDefault();
  if (document.getElementById('login-user').value.trim() === CREDS.user && document.getElementById('login-pass').value === CREDS.pass) {
    sessionStorage.setItem(SESSION_KEY, '1');
    showAdmin();
  } else {
    document.getElementById('login-error').classList.remove('hidden');
  }
});
document.getElementById('btn-logout').addEventListener('click', () => { sessionStorage.removeItem(SESSION_KEY); location.reload(); });

function showAdmin() {
  document.getElementById('screen-login').classList.add('hidden');
  const admin = document.getElementById('screen-admin');
  admin.style.display = '';
  admin.classList.remove('hidden');
  loadSongs(); loadEvents();
}
if (sessionStorage.getItem(SESSION_KEY) === '1') showAdmin();

// Onglets
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const tab = btn.dataset.tab;
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.toggle('border-blue-900', b === btn); b.classList.toggle('text-blue-900', b === btn);
      b.classList.toggle('border-transparent', b !== btn); b.classList.toggle('text-stone-500', b !== btn);
    });
    document.getElementById('tab-songs').classList.toggle('hidden', tab !== 'songs');
    document.getElementById('tab-events').classList.toggle('hidden', tab !== 'events');
  });
});

function setStatus(id, type, msg) {
  const el = document.getElementById(id);
  el.className = `rounded-lg px-3 py-2 text-sm ${type === 'ok' ? 'bg-green-50 text-green-700' : type === 'loading' ? 'bg-blue-50 text-blue-700' : 'bg-red-50 text-red-600'}`;
  el.textContent = msg;
  el.classList.remove('hidden');
}

// Chants
let adminSongsCache = [];
let adminActiveFilter = '';

function applyAdminFilters() {
  const query = document.getElementById('admin-search').value.toLowerCase().trim();
  const rows = document.querySelectorAll('#songs-list [data-song-row]');
  let visible = 0;
  rows.forEach(row => {
    const titleMatch = row.dataset.title.includes(query);
    const filterMatch = !adminActiveFilter || row.dataset.occasion === adminActiveFilter;
    const show = titleMatch && filterMatch;
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('admin-no-results').classList.toggle('hidden', visible > 0);
}

async function loadSongs() {
  const list = document.getElementById('songs-list');
  list.innerHTML = '<p class="px-6 py-5 text-stone-400 italic">Chargement…</p>';
  const files = await ghGet('contents/src/content/songs');
  if (!Array.isArray(files)) { list.innerHTML = '<p class="px-6 py-5 text-red-400">Erreur (token invalide ?).</p>'; return; }
  const songs = await Promise.all(files.map(async f => {
    const d = await ghGet(`contents/${f.path}`);
    const md = b64decode(d.content);
    const bodyParts = md.split(/^---\s*$/m);
    return { path: f.path, sha: d.sha,
      title: md.match(/^title:\s*(.+)$/m)?.[1]?.trim().replace(/^"|"$/g, '') || f.name,
      key: md.match(/^key:\s*(.+)$/m)?.[1]?.trim() || '',
      occasion: md.match(/^occasion:\s*(.+)$/m)?.[1]?.trim() || '',
      pdf: md.match(/^pdf:\s*(.+)$/m)?.[1]?.trim() || '',
      bodyContent: bodyParts.length >= 3 ? bodyParts.slice(2).join('---').trim() : '' };
  }));
  songs.sort((a, b) => a.title.localeCompare(b.title, 'fr'));
  adminSongsCache = songs;

  // Filtres par occasion
  const occasions = [...new Set(songs.map(s => s.occasion).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'fr'));
  adminActiveFilter = '';
  const filtersEl = document.getElementById('admin-filters');
  filtersEl.innerHTML = ['', ...occasions].map((occ, i) => `
    <button data-occ="${occ}"
      class="admin-filter-btn rounded-full border px-2.5 py-0.5 text-xs font-medium transition-colors ${i === 0 ? 'border-blue-900 bg-blue-900 text-white' : 'border-stone-300 text-stone-600 hover:border-blue-900 hover:bg-blue-50 hover:text-blue-900'}">
      ${occ || 'Tous'}
    </button>`).join('');
  filtersEl.querySelectorAll('.admin-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      adminActiveFilter = btn.dataset.occ;
      filtersEl.querySelectorAll('.admin-filter-btn').forEach(b => {
        const on = b === btn;
        b.classList.toggle('bg-blue-900', on); b.classList.toggle('text-white', on); b.classList.toggle('border-blue-900', on);
        b.classList.toggle('text-stone-600', !on); b.classList.toggle('border-stone-300', !on);
      });
      applyAdminFilters();
    });
  });

  list.innerHTML = songs.length ? songs.map(s => `
    <div data-song-row data-title="${s.title.toLowerCase()}" data-occasion="${s.occasion}"
      class="flex items-center justify-between px-6 py-3 hover:bg-stone-50">
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-medium text-stone-900">${s.title}</span>
        ${s.key ? `<span class="text-xs text-stone-400">${s.key}</span>` : ''}
        ${s.occasion ? `<span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-500">${s.occasion}</span>` : ''}
      </div>
      <div class="ml-4 flex flex-shrink-0 items-center gap-3">
        <button data-idx="${songs.indexOf(s)}"
          class="btn-mod-song text-xs font-medium text-blue-600 hover:text-blue-800 transition-colors">Modifier</button>
        <button data-path="${s.path}" data-sha="${s.sha}" data-name="${s.title}"
          class="btn-del-song text-xs font-medium text-red-400 hover:text-red-600 transition-colors">Supprimer</button>
      </div>
    </div>`).join('') : '<p class="px-6 py-5 text-stone-400 italic">Aucun chant.</p>';

  list.querySelectorAll('.btn-mod-song').forEach(btn => {
    btn.addEventListener('click', () => openEditModal(adminSongsCache[parseInt(btn.dataset.idx)]));
  });

  list.querySelectorAll('.btn-del-song').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm(`Supprimer définitivement "${btn.dataset.name}" ?`)) return;
      btn.textContent = '…'; btn.disabled = true;
      if (await ghDelete(btn.dataset.path, btn.dataset.sha, `suppr: ${btn.dataset.name}`)) { loadSongs(); triggerRebuild(); }
      else { btn.textContent = 'Erreur'; btn.disabled = false; }
    });
  });

  document.getElementById('admin-search').addEventListener('input', applyAdminFilters);
}

document.getElementById('form-add-song').addEventListener('submit', async e => {
  e.preventDefault();
  const title = document.getElementById('song-title').value.trim();
  const key = document.getElementById('song-key').value.trim();
  const occasion = document.getElementById('song-occasion').value.trim();
  const pdfFile = document.getElementById('song-pdf').files[0];
  setStatus('song-status', 'loading', 'Enregistrement en cours…');
  try {
    const slug = slugify(title);
    let pdfPath = '';
    if (pdfFile) {
      await ghPut(`public/uploads/${slug}.pdf`, await fileToBase64(pdfFile), `ajout partition: ${title}`);
      pdfPath = `uploads/${slug}.pdf`;
    }
    const audioVoices = [
      { id: 'song-audio-s', field: 'audio_soprano', suffix: '-soprano' },
      { id: 'song-audio-a', field: 'audio_alto',    suffix: '-alto'    },
      { id: 'song-audio-t', field: 'audio_tenor',   suffix: '-tenor'   },
      { id: 'song-audio-b', field: 'audio_basse',   suffix: '-basse'   },
    ];
    const audioPaths: Record<string, string> = {};
    for (const v of audioVoices) {
      const file = (document.getElementById(v.id) as HTMLInputElement).files?.[0];
      if (file) {
        const ext = file.name.split('.').pop() || 'mp3';
        await ghPut(`public/uploads/${slug}${v.suffix}.${ext}`, await fileToBase64(file), `ajout audio ${v.field}: ${title}`);
        audioPaths[v.field] = `uploads/${slug}${v.suffix}.${ext}`;
      }
    }
    const mdLines = ['---', `title: ${yamlStr(title)}`, key ? `key: ${yamlStr(key)}` : null, `occasion: ${yamlStr(occasion)}`,
      pdfPath ? `pdf: ${pdfPath}` : null,
      audioPaths.audio_soprano ? `audio_soprano: ${audioPaths.audio_soprano}` : null,
      audioPaths.audio_alto    ? `audio_alto: ${audioPaths.audio_alto}`       : null,
      audioPaths.audio_tenor   ? `audio_tenor: ${audioPaths.audio_tenor}`     : null,
      audioPaths.audio_basse   ? `audio_basse: ${audioPaths.audio_basse}`     : null,
      '---', ''].filter(l => l !== null).join('\n');
    await ghPut(`src/content/songs/${slug}.md`, b64encode(mdLines), `ajout chant: ${title}`);
    setStatus('song-status', 'ok', '✓ Ajouté. Mise à jour du site dans ~2 min.'); e.target.reset(); loadSongs(); triggerRebuild();
  } catch(err) { setStatus('song-status', 'error', 'Erreur : ' + err.message); }
});

// ── Modale édition chant ───────────────────────────────────
const editModal = document.getElementById('modal-edit-song');
let currentEditSong = null;

function openEditModal(song) {
  currentEditSong = song;
  document.getElementById('edit-path').value = song.path;
  document.getElementById('edit-sha').value = song.sha;
  document.getElementById('edit-body-content').value = song.bodyContent || '';
  document.getElementById('edit-title').value = song.title;
  document.getElementById('edit-key').value = song.key;
  buildOccasionSelect(document.getElementById('edit-occasion'), song.occasion);
  document.getElementById('edit-current-pdf').textContent =
    song.pdf ? `Partition actuelle : ${song.pdf.split('/').pop()}` : 'Aucune partition enregistrée.';
  document.getElementById('edit-pdf').value = '';
  document.getElementById('edit-status').classList.add('hidden');
  editModal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeEditModal() {
  editModal.style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('btn-close-edit-modal').addEventListener('click', closeEditModal);
document.getElementById('btn-cancel-edit').addEventListener('click', closeEditModal);
editModal.addEventListener('click', e => { if (e.target === editModal) closeEditModal(); });

document.getElementById('form-edit-song').addEventListener('submit', async e => {
  e.preventDefault();
  const path        = document.getElementById('edit-path').value;
  const sha         = document.getElementById('edit-sha').value;
  const title       = document.getElementById('edit-title').value.trim();
  const key         = document.getElementById('edit-key').value.trim();
  const occasion    = document.getElementById('edit-occasion').value;
  const pdfFile     = document.getElementById('edit-pdf').files[0];
  const bodyContent = document.getElementById('edit-body-content').value;
  if (!title || !occasion) return;
  setStatus('edit-status', 'loading', 'Enregistrement en cours…');
  try {
    let pdfPath = currentEditSong.pdf || '';
    if (pdfFile) {
      await ghPut(`public/uploads/${slugify(title)}.pdf`, await fileToBase64(pdfFile), `partition: ${title}`);
      pdfPath = `uploads/${slugify(title)}.pdf`;
    }
    const md = ['---', `title: ${yamlStr(title)}`, key ? `key: ${yamlStr(key)}` : null,
      `occasion: ${yamlStr(occasion)}`, pdfPath ? `pdf: ${pdfPath}` : null, '---',
      bodyContent || ''].filter(l => l !== null).join('\n');
    await ghPut(path, b64encode(md), `modif chant: ${title}`, sha);
    setStatus('edit-status', 'ok', '✓ Modifié. Mise à jour dans ~2 min.');
    setTimeout(() => { closeEditModal(); loadSongs(); triggerRebuild(); }, 1200);
  } catch(err) { setStatus('edit-status', 'error', 'Erreur : ' + err.message); }
});

// ── Événements ────────────────────────────────────────────────
let adminEvtsCache = [];

function buildProgramSlots(container, currentProgram) {
  container.innerHTML = MASS_SLOTS.map(slot => {
    const songs = adminSongsCache.filter(s => (slot.key === 'en_plus' || s.occasion === slot.occasion) && s.pdf);
    const cur = (currentProgram || {})[slot.key] || '';
    const opts = songs.map(s => `<option value="${s.pdf}"${s.pdf === cur ? ' selected' : ''}>${s.title}</option>`).join('');
    return `<div class="flex items-center gap-2">
      <span class="w-36 flex-shrink-0 text-xs font-medium text-stone-600">${slot.label}</span>
      <select class="slot-select flex-1 rounded-lg border border-stone-300 px-2 py-1.5 text-xs focus:border-blue-700 focus:outline-none" data-slot="${slot.key}">
        <option value="">-- Aucun --</option>${opts}
      </select>
      <label class="flex-shrink-0 cursor-pointer rounded border border-stone-300 px-2 py-1 text-xs text-stone-500 hover:border-blue-600 hover:text-blue-700 transition-colors">
        Importer
        <input type="file" accept=".pdf" class="slot-file hidden" data-slot="${slot.key}" data-occasion="${slot.occasion}" data-label="${slot.label}" />
      </label>
      <span class="slot-status w-4 flex-shrink-0 text-xs text-stone-400" data-slot="${slot.key}"></span>
    </div>`;
  }).join('');

  container.querySelectorAll('.slot-file').forEach(input => {
    input.addEventListener('change', async () => {
      const file = input.files[0]; if (!file) return;
      const title = prompt(`Titre du chant (${input.dataset.label}) :`, file.name.replace(/\.pdf$/i, ''));
      if (!title) { input.value = ''; return; }
      const statusEl = container.querySelector(`.slot-status[data-slot="${input.dataset.slot}"]`);
      statusEl.textContent = '…';
      try {
        const pdfPath = `uploads/${slugify(title)}.pdf`;
        await ghPut(`public/${pdfPath}`, await fileToBase64(file), `partition: ${title}`);
        const songMd = ['---', `title: ${yamlStr(title)}`, `occasion: ${yamlStr(input.dataset.occasion)}`, `pdf: ${pdfPath}`, '---', ''].join('\n');
        await ghPut(`src/content/songs/${slugify(title)}.md`, b64encode(songMd), `ajout chant: ${title}`);
        const sel = container.querySelector(`.slot-select[data-slot="${input.dataset.slot}"]`);
        const opt = new Option(title, pdfPath, true, true);
        sel.appendChild(opt);
        statusEl.textContent = '✓';
        loadSongs();
      } catch { statusEl.textContent = '✗'; }
    });
  });
}

// Wizard ajout événement
let evtStep = 1;
function showEvtStep(n) {
  evtStep = n;
  [1, 2, 3].forEach(i => document.getElementById('evt-step-' + i).classList.toggle('hidden', i !== n));
  const isMesse = document.querySelector('input[name="evt-type"]:checked')?.value === 'messe';
  document.getElementById('evt-ind-sep1').classList.toggle('hidden', n < 2 || !isMesse);
  document.getElementById('evt-ind-2').classList.toggle('hidden', n < 2 || !isMesse);
  document.getElementById('evt-ind-sep2').classList.toggle('hidden', n < 3);
  document.getElementById('evt-ind-3').classList.toggle('hidden', n < 3);
  ['evt-ind-1','evt-ind-2','evt-ind-3'].forEach((id, i) => {
    const el = document.getElementById(id);
    if (el) { el.classList.toggle('font-semibold', n === i + 1); el.classList.toggle('text-blue-900', n >= i + 1); el.classList.toggle('text-stone-400', n < i + 1); }
  });
}

document.getElementById('evt-btn-next1').addEventListener('click', () => {
  const title = document.getElementById('evt-title').value.trim();
  const date  = document.getElementById('evt-date').value;
  const time  = document.getElementById('evt-time').value;
  const loc   = document.getElementById('evt-location').value.trim();
  if (!title || !date || !time || !loc) {
    setStatus('evt-status-1', 'error', 'Veuillez remplir les champs obligatoires.');
    return;
  }
  document.getElementById('evt-status-1').classList.add('hidden');
  const isMesse = document.querySelector('input[name="evt-type"]:checked')?.value === 'messe';
  if (isMesse) {
    buildProgramSlots(document.getElementById('evt-program-slots'), {});
    showEvtStep(2);
  } else {
    showEvtStep(3);
  }
});
document.getElementById('evt-btn-back2').addEventListener('click', () => showEvtStep(1));
document.getElementById('evt-btn-next2').addEventListener('click', () => showEvtStep(3));
document.getElementById('evt-btn-back3').addEventListener('click', () => {
  const isMesse = document.querySelector('input[name="evt-type"]:checked')?.value === 'messe';
  showEvtStep(isMesse ? 2 : 1);
});
document.getElementById('evt-btn-submit').addEventListener('click', submitEvt);

async function submitEvt(editPath, editSha) {
  const isEdit = typeof editPath === 'string';
  const title = document.getElementById(isEdit ? 'edit-evt-title' : 'evt-title').value.trim();
  const date  = document.getElementById(isEdit ? 'edit-evt-date'  : 'evt-date').value;
  const time  = document.getElementById(isEdit ? 'edit-evt-time'  : 'evt-time').value;
  const loc   = document.getElementById(isEdit ? 'edit-evt-location' : 'evt-location').value.trim();
  const desc  = document.getElementById(isEdit ? 'edit-evt-description' : 'evt-description').value.trim();
  const type  = document.querySelector(`input[name="${isEdit ? 'edit-evt-type' : 'evt-type'}"]:checked`)?.value || 'messe';
  const anim  = document.getElementById(isEdit ? 'edit-evt-animateur'  : 'evt-animateur').value.trim();
  const chef  = document.getElementById(isEdit ? 'edit-evt-chef-choeur': 'evt-chef-choeur').value.trim();
  const statusId = isEdit ? 'edit-evt-status' : 'evt-status';
  if (!title || !date) { setStatus(statusId, 'error', 'Titre et date obligatoires.'); return; }
  setStatus(statusId, 'loading', 'Enregistrement en cours…');
  try {
    const lines = ['---', `title: ${yamlStr(title)}`, `date: ${date}`, `time: "${time}"`, `location: ${yamlStr(loc)}`];
    if (desc) lines.push(`description: ${yamlStr(desc)}`);
    lines.push(`type: ${type}`);
    if (anim) lines.push(`animateur: ${yamlStr(anim)}`);
    if (chef) lines.push(`chef_choeur: ${yamlStr(chef)}`);
    const slotsContainer = document.getElementById(isEdit ? 'edit-evt-program-slots' : 'evt-program-slots');
    slotsContainer?.querySelectorAll('.slot-select').forEach(sel => {
      if (sel.value) lines.push(`program_${sel.dataset.slot}: ${sel.value}`);
    });
    lines.push('---', '');
    const filePath = isEdit ? editPath : `src/content/events/${date}-${slugify(title)}.md`;
    await ghPut(filePath, b64encode(lines.join('\n')), `${isEdit ? 'modif' : 'ajout'} événement: ${title}`, isEdit ? editSha : undefined);
    setStatus(statusId, 'ok', `✓ ${isEdit ? 'Modifié' : 'Ajouté'}. Mise à jour dans ~2 min.`);
    setTimeout(() => {
      if (isEdit) { closeEditEventModal(); }
      else {
        ['evt-title','evt-date','evt-time','evt-location','evt-description','evt-animateur','evt-chef-choeur'].forEach(id => { const el = document.getElementById(id); if(el) el.value=''; });
        showEvtStep(1);
      }
      loadEvents(); triggerRebuild();
    }, 1000);
  } catch(err) { setStatus(statusId, 'error', 'Erreur : ' + err.message); }
}

async function loadEvents() {
  const list = document.getElementById('events-list');
  list.innerHTML = '<p class="px-6 py-5 text-stone-400 italic">Chargement…</p>';
  const files = await ghGet('contents/src/content/events');
  if (!Array.isArray(files)) { list.innerHTML = '<p class="px-6 py-5 text-red-400">Erreur de chargement.</p>'; return; }
  const evts = await Promise.all(files.map(async f => {
    const d = await ghGet(`contents/${f.path}`);
    const md = b64decode(d.content);
    const ev = {
      path: f.path, sha: d.sha,
      title:       md.match(/^title:\s*(.+)$/m)?.[1]?.trim().replace(/^"|"$/g,'') || f.name,
      date:        md.match(/^date:\s*(.+)$/m)?.[1]?.trim() || '',
      time:        md.match(/^time:\s*"?([^"\n]+)"?$/m)?.[1]?.trim() || '',
      location:    md.match(/^location:\s*(.+)$/m)?.[1]?.trim() || '',
      description: md.match(/^description:\s*(.+)$/m)?.[1]?.trim() || '',
      type:        md.match(/^type:\s*(.+)$/m)?.[1]?.trim() || 'messe',
      animateur:   md.match(/^animateur:\s*(.+)$/m)?.[1]?.trim() || '',
      chef_choeur: md.match(/^chef_choeur:\s*(.+)$/m)?.[1]?.trim() || '',
    };
    MASS_SLOTS.forEach(s => {
      ev['program_' + s.key] = md.match(new RegExp(`^program_${s.key}:\\s*(.+)$`, 'm'))?.[1]?.trim() || '';
    });
    return ev;
  }));
  evts.sort((a, b) => a.date.localeCompare(b.date));
  adminEvtsCache = evts;
  list.innerHTML = evts.length ? evts.map((ev, idx) => `
    <div class="flex items-center justify-between px-6 py-3 hover:bg-stone-50">
      <div>
        <span class="font-medium text-stone-900">${ev.title}</span>
        <span class="ml-2 text-xs text-stone-400">${ev.date}${ev.time ? ' à ' + ev.time : ''} — ${ev.location}</span>
        ${ev.type === 'messe' ? '<span class="ml-1 rounded-full bg-blue-50 px-2 py-0.5 text-xs text-blue-600">Messe</span>' : ''}
      </div>
      <div class="ml-4 flex flex-shrink-0 items-center gap-3">
        <button data-idx="${idx}" class="btn-mod-evt text-xs font-medium text-blue-600 hover:text-blue-800 transition-colors">Modifier</button>
        <button data-path="${ev.path}" data-sha="${ev.sha}" data-name="${ev.title}"
          class="btn-del-evt text-xs font-medium text-red-400 hover:text-red-600 transition-colors">Supprimer</button>
      </div>
    </div>`).join('') : '<p class="px-6 py-5 text-stone-400 italic">Aucun événement.</p>';

  list.querySelectorAll('.btn-mod-evt').forEach(btn => {
    btn.addEventListener('click', () => openEditEventModal(adminEvtsCache[parseInt(btn.dataset.idx)]));
  });
  list.querySelectorAll('.btn-del-evt').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm(`Supprimer définitivement "${btn.dataset.name}" ?`)) return;
      btn.textContent = '…'; btn.disabled = true;
      if (await ghDelete(btn.dataset.path, btn.dataset.sha, `suppr: ${btn.dataset.name}`)) { loadEvents(); triggerRebuild(); }
      else { btn.textContent = 'Erreur'; btn.disabled = false; }
    });
  });
}

// ── Modale édition événement ───────────────────────────────────
const editEvtModal = document.getElementById('modal-edit-event');

function openEditEventModal(ev) {
  document.getElementById('edit-evt-path').value = ev.path;
  document.getElementById('edit-evt-sha').value  = ev.sha;
  document.getElementById('edit-evt-title').value = ev.title;
  document.getElementById('edit-evt-date').value  = ev.date;
  document.getElementById('edit-evt-time').value  = ev.time;
  document.getElementById('edit-evt-location').value = ev.location;
  document.getElementById('edit-evt-description').value = ev.description;
  document.querySelectorAll('input[name="edit-evt-type"]').forEach(r => r.checked = r.value === ev.type);
  document.getElementById('edit-evt-animateur').value   = ev.animateur;
  document.getElementById('edit-evt-chef-choeur').value = ev.chef_choeur;
  const isMesse = ev.type === 'messe';
  document.getElementById('edit-evt-program-section').classList.toggle('hidden', !isMesse);
  if (isMesse) {
    const prog = {};
    MASS_SLOTS.forEach(s => { prog[s.key] = ev['program_' + s.key] || ''; });
    buildProgramSlots(document.getElementById('edit-evt-program-slots'), prog);
  }
  document.getElementById('edit-evt-status').classList.add('hidden');
  editEvtModal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeEditEventModal() {
  editEvtModal.style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('btn-close-edit-event').addEventListener('click', closeEditEventModal);
document.getElementById('btn-cancel-edit-event').addEventListener('click', closeEditEventModal);
editEvtModal.addEventListener('click', e => { if (e.target === editEvtModal) closeEditEventModal(); });

document.getElementById('form-edit-event').addEventListener('submit', e => {
  e.preventDefault();
  submitEvt(document.getElementById('edit-evt-path').value, document.getElementById('edit-evt-sha').value);
});
</script>
</body>
</html>
