function parsePdfsFromMd(md) {
  const result = [];
  const re = /^  - label:\s*(.+)\n    url:\s*(.+)$/gm;
  let m;
  while ((m = re.exec(md)) !== null) {
    result.push({ label: m[1].trim().replace(/^"|"$/g, ''), url: m[2].trim() });
  }
  return result;
}

function addPdfEntry(container, opts = {}) {
