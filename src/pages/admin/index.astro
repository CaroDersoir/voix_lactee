document.getElementById('evt-btn-back2').addEventListener('click', () => showEvtStep(1));
document.getElementById('evt-btn-next2').addEventListener('click', () => showEvtStep(3));
document.getElementById('evt-btn-back3').addEventListener('click', () => showEvtStep(2));
document.getElementById('evt-btn-submit').addEventListener('click', submitEvt);

async function submitEvt(editPath, editSha) {
  const isEdit = typeof editPath === 'string';
  const title = document.getElementById(isEdit ? 'edit-evt-title' : 'evt-title').value.trim();
  const date  = document.getElementById(isEdit ? 'edit-evt-date'  : 'evt-date').value;
  const time  = document.getElementById(isEdit ? 'edit-evt-time'  : 'evt-time').value;
  const loc   = document.getElementById(isEdit ? 'edit-evt-location' : 'evt-location').value.trim();
  const desc  = document.getElementById(isEdit ? 'edit-evt-description' : 'evt-description').value.trim();
  const type  = document.querySelector(`input[name="${isEdit ? 'edit-evt-type' : 'evt-type'}"]:checked`)?.value || 'messe';
  const anim  = document.getElementById(isEdit ? 'edit-evt-animateur'  : 'evt-animateur').value.trim();
  const chef  = document.getElementById(isEdit ? 'edit-evt-chef-choeur': 'evt-chef-choeur').value.trim();
  const org   = document.getElementById(isEdit ? 'edit-evt-organiste'  : 'evt-organiste').value.trim();
  const statusId = isEdit ? 'edit-evt-status' : 'evt-status';
  if (!title) { setStatus(statusId, 'error', 'Le titre est obligatoire.'); return; }
  setStatus(statusId, 'loading', 'Enregistrement en cours…');
  try {
    const lines = ['---', `title: ${yamlStr(title)}`];
    if (date) lines.push(`date: ${date}`);
    if (time) lines.push(`time: "${time}"`);
    if (loc)  lines.push(`location: ${yamlStr(loc)}`);
    if (desc) lines.push(`description: ${yamlStr(desc)}`);
    lines.push(`type: ${type}`);
    if (anim) lines.push(`animateur: ${yamlStr(anim)}`);
    if (chef) lines.push(`chef_choeur: ${yamlStr(chef)}`);
    if (org)  lines.push(`organiste: ${yamlStr(org)}`);
    if (type === 'autre') {
      const autreContainer = document.getElementById(isEdit ? 'edit-evt-program-autre' : 'evt-program-autre');
      getAutreSlots(autreContainer).forEach((e, i) => {
        if (e.label) lines.push(`program_autre_${i}_label: ${yamlStr(e.label)}`);
        if (e.pdf)   lines.push(`program_autre_${i}_pdf: ${e.pdf}`);
      });
    } else {
      const slotsContainer = document.getElementById(isEdit ? 'edit-evt-program-slots' : 'evt-program-slots');
      slotsContainer?.querySelectorAll('.slot-select').forEach(sel => {
        if (sel.value && sel.value !== '__autre__') lines.push(`program_${sel.dataset.slot}: ${sel.value}`);
      });
    }
    lines.push('---', '');
    const filePath = isEdit ? editPath : `src/content/events/${(date || new Date().toISOString().slice(0,10))}-${slugify(title)}.md`;
    await ghPut(filePath, b64encode(lines.join('\n')), `${isEdit ? 'modif' : 'ajout'} événement: ${title}`, isEdit ? editSha : undefined);
    setStatus(statusId, 'ok', `✓ ${isEdit ? 'Modifié' : 'Ajouté'}. Mise à jour dans ~2 min.`);
    setTimeout(() => {
      if (isEdit) { closeEditEventModal(); }
      else {
        ['evt-title','evt-date','evt-time','evt-location','evt-description','evt-animateur','evt-chef-choeur','evt-organiste'].forEach(id => { const el = document.getElementById(id); if(el) el.value=''; });
        showEvtStep(1);
      }
      loadEvents(); triggerRebuild();
    }, 1000);
  } catch(err) { setStatus(statusId, 'error', 'Erreur : ' + err.message); }
}

async function loadEvents() {
  const list = document.getElementById('events-list');
  list.innerHTML = '<p class="px-6 py-5 text-stone-400 italic">Chargement…</p>';
  const files = await ghGet('contents/src/content/events');
  if (!Array.isArray(files)) { list.innerHTML = '<p class="px-6 py-5 text-red-400">Erreur de chargement.</p>'; return; }
  const evts = await Promise.all(files.map(async f => {
    const d = await ghGet(`contents/${f.path}`);
    const md = b64decode(d.content);
    const ev = {
      path: f.path, sha: d.sha,
      title:       parseYamlVal(md.match(/^title:\s*(.+)$/m)?.[1]) || f.name,
      date:        md.match(/^date:\s*(.+)$/m)?.[1]?.trim() || '',
      time:        md.match(/^time:\s*"?([^"\n]+)"?$/m)?.[1]?.trim() || '',
      location:    parseYamlVal(md.match(/^location:\s*(.+)$/m)?.[1]),
      description: parseYamlVal(md.match(/^description:\s*(.+)$/m)?.[1]),
      type:        md.match(/^type:\s*(.+)$/m)?.[1]?.trim() || 'messe',
      animateur:   parseYamlVal(md.match(/^animateur:\s*(.+)$/m)?.[1]),
      chef_choeur: parseYamlVal(md.match(/^chef_choeur:\s*(.+)$/m)?.[1]),
      organiste:   parseYamlVal(md.match(/^organiste:\s*(.+)$/m)?.[1]),
    };
    [...MASS_SLOTS, ...WEDDING_EXTRA_SLOTS, ...BENEDICTION_EXTRA_SLOTS].forEach(s => {
      ev['program_' + s.key] = md.match(new RegExp(`^program_${s.key}:\\s*(.+)$`, 'm'))?.[1]?.trim() || '';
    });
    const autreEntries = [];
    for (let i = 0; i < 30; i++) {
      const lbl = md.match(new RegExp(`^program_autre_${i}_label:\\s*(.+)$`, 'm'))?.[1]?.trim() || '';
      const pdf = md.match(new RegExp(`^program_autre_${i}_pdf:\\s*(.+)$`, 'm'))?.[1]?.trim() || '';
      if (!lbl && !pdf) break;
      autreEntries.push({ label: lbl, pdf });
    }
    ev.programAutre = autreEntries;
    return ev;
  }));
  evts.sort((a, b) => a.date.localeCompare(b.date));
  adminEvtsCache = evts;
  list.innerHTML = evts.length ? evts.map((ev, idx) => `
    <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 hover:bg-stone-50 sm:px-6">
      <div>
        <span class="font-medium text-stone-900">${ev.title}</span>
        <span class="ml-2 text-xs text-stone-400">${ev.date}${ev.time ? ' à ' + ev.time : ''} — ${ev.location}</span>
        ${ev.type === 'messe' ? '<span class="ml-1 rounded-full bg-blue-50 px-2 py-0.5 text-xs text-blue-600">Messe</span>' : ev.type === 'messe_mariage' ? '<span class="ml-1 rounded-full bg-pink-50 px-2 py-0.5 text-xs text-pink-600">Messe mariage</span>' : ev.type === 'benediction' ? '<span class="ml-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-600">Bénédiction</span>' : ''}
      </div>
      <div class="ml-4 flex flex-shrink-0 items-center gap-3">
        <button data-idx="${idx}" class="btn-mod-evt text-xs font-medium text-blue-600 hover:text-blue-800 transition-colors">Modifier</button>
        <button data-path="${ev.path}" data-sha="${ev.sha}" data-name="${ev.title}"
          class="btn-del-evt text-xs font-medium text-red-400 hover:text-red-600 transition-colors">Supprimer</button>
      </div>
    </div>`).join('') : '<p class="px-6 py-5 text-stone-400 italic">Aucun événement.</p>';

  list.querySelectorAll('.btn-mod-evt').forEach(btn => {
    btn.addEventListener('click', () => openEditEventModal(adminEvtsCache[parseInt(btn.dataset.idx)]));
  });
  list.querySelectorAll('.btn-del-evt').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm(`Supprimer définitivement "${btn.dataset.name}" ?`)) return;
      btn.textContent = '…'; btn.disabled = true;
      if (await ghDelete(btn.dataset.path, btn.dataset.sha, `suppr: ${btn.dataset.name}`)) { loadEvents(); triggerRebuild(); }
      else { btn.textContent = 'Erreur'; btn.disabled = false; }
    });
  });
}

// ── Modale édition événement ───────────────────────────────────
const editEvtModal = document.getElementById('modal-edit-event');

function openEditEventModal(ev) {
  document.getElementById('edit-evt-path').value = ev.path;
  document.getElementById('edit-evt-sha').value  = ev.sha;
  document.getElementById('edit-evt-title').value = ev.title;
  document.getElementById('edit-evt-date').value  = ev.date;
  document.getElementById('edit-evt-time').value  = ev.time;
  document.getElementById('edit-evt-location').value = ev.location;
  document.getElementById('edit-evt-description').value = ev.description;
  document.querySelectorAll('input[name="edit-evt-type"]').forEach(r => r.checked = r.value === ev.type);
  document.getElementById('edit-evt-animateur').value   = ev.animateur;
  document.getElementById('edit-evt-chef-choeur').value = ev.chef_choeur;
  document.getElementById('edit-evt-organiste').value   = ev.organiste;
  document.getElementById('edit-evt-program-section').classList.remove('hidden');
  if (ev.type === 'autre') {
    document.getElementById('edit-evt-program-slots-wrapper').classList.add('hidden');
    document.getElementById('edit-evt-program-autre-wrapper').classList.remove('hidden');
    buildAutreSlots(document.getElementById('edit-evt-program-autre'), ev.programAutre || []);
  } else {
    document.getElementById('edit-evt-program-slots-wrapper').classList.remove('hidden');
    document.getElementById('edit-evt-program-autre-wrapper').classList.add('hidden');
    const prog = {};
    slotsForType(ev.type).forEach(s => { prog[s.key] = ev['program_' + s.key] || ''; });
    buildProgramSlots(document.getElementById('edit-evt-program-slots'), prog, ev.type);
  }
  document.getElementById('edit-evt-status').classList.add('hidden');
  editEvtModal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeEditEventModal() {
  editEvtModal.style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('btn-close-edit-event').addEventListener('click', closeEditEventModal);
document.getElementById('btn-cancel-edit-event').addEventListener('click', closeEditEventModal);
editEvtModal.addEventListener('click', e => { if (e.target === editEvtModal) closeEditEventModal(); });

document.querySelectorAll('input[name="edit-evt-type"]').forEach(radio => {
  radio.addEventListener('change', () => {
    const type = radio.value;
    const section = document.getElementById('edit-evt-program-section');
    section.classList.toggle('hidden', !hasProgram(type));
    if (hasProgram(type)) {
      const currentProg = collectSlotValues(document.getElementById('edit-evt-program-slots'));
      buildProgramSlots(document.getElementById('edit-evt-program-slots'), currentProg, type);
    }
  });
});

document.getElementById('form-edit-event').addEventListener('submit', e => {
  e.preventDefault();
  submitEvt(document.getElementById('edit-evt-path').value, document.getElementById('edit-evt-sha').value);
});

// ── Programme libre (type "autre") ────────────────────────────
let autreSlotCounter = 0;

function buildAutreSlots(container, entries) {
  container.innerHTML = `
    <p class="mb-2 text-xs text-stone-400">Ajoutez les chants dans l'ordre. Le libellé est libre (ex. : "Ouverture", "Méditation", "Final").</p>
    <div class="autre-entries space-y-2"></div>
    <button type="button" class="btn-add-autre mt-2 w-full rounded-lg border border-dashed border-stone-300 px-3 py-1.5 text-xs text-stone-500 hover:border-blue-600 hover:text-blue-700 transition-colors">
      + Ajouter un chant
    </button>`;
  const entriesEl = container.querySelector('.autre-entries');

  function addAutreEntry(label, pdf) {
    const slotKey = `autre-${autreSlotCounter++}`;
    const allSongs = adminSongsCache.filter(s => s.pdf).sort((a, b) => a.title.localeCompare(b.title, 'fr'));
    const opts = allSongs.map(s => `<option value="${s.pdf}"${s.pdf === pdf ? ' selected' : ''}>${s.title}</option>`).join('');
    const row = document.createElement('div');
    row.className = 'autre-entry flex flex-wrap items-center gap-2';
    row.innerHTML = `
      <input type="text" value="${(label || '').replace(/"/g, '&quot;')}" placeholder="Libellé (ex. : Ouverture)"
        class="autre-label w-full flex-shrink-0 rounded-lg border border-stone-300 px-2 py-1.5 text-xs focus:border-blue-700 focus:outline-none sm:w-36" />
      <select class="slot-select min-w-0 flex-1 rounded-lg border border-stone-300 px-2 py-1.5 text-xs focus:border-blue-700 focus:outline-none"
        data-slot="${slotKey}" data-occasion="" data-label="">
        <option value="">-- Aucun chant --</option>${opts}
        <option value="__autre__">⊕ Chercher un autre chant…</option>
      </select>
      <span class="slot-status w-4 flex-shrink-0 text-xs text-stone-400" data-slot="${slotKey}"></span>
      <button type="button" class="btn-remove-autre flex-shrink-0 px-1 text-lg leading-none text-stone-300 hover:text-red-500 transition-colors">×</button>`;
    row.querySelector('.slot-select').addEventListener('change', e => {
      if (e.target.value === '__autre__') {
        e.target.value = '';
        const lbl = row.querySelector('.autre-label').value.trim() || 'chant';
        openSongPicker(slotKey, '', lbl, container);
      }
    });
    row.querySelector('.btn-remove-autre').addEventListener('click', () => row.remove());
    entriesEl.appendChild(row);
  }

  container.querySelector('.btn-add-autre').addEventListener('click', () => addAutreEntry('', ''));
  (entries || []).forEach(e => addAutreEntry(e.label, e.pdf));
}

function getAutreSlots(container) {
  if (!container) return [];
  return [...container.querySelectorAll('.autre-entry')].map(row => ({
    label: row.querySelector('.autre-label')?.value.trim() || '',
    pdf:   row.querySelector('.slot-select')?.value || ''
  })).filter(e => e.label || e.pdf);
}

// ── Sélecteur de chant (pour les slots de programme) ──────────
const pickerModal = document.getElementById('modal-song-picker');
let pickerCtx = null;

function openSongPicker(slot, occasion, label, container) {
  pickerCtx = { slot, occasion, label, container };
  document.getElementById('picker-title').textContent = `Choisir un chant — ${label}`;
  document.getElementById('picker-note').textContent = occasion
    ? `L'occasion « ${occasion} » sera ajoutée automatiquement si le chant ne l'a pas encore.`
    : '';
  document.getElementById('picker-search').value = '';
  renderPickerList('');
  pickerModal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  setTimeout(() => document.getElementById('picker-search').focus(), 50);
}

function renderPickerList(query) {
  const q = query.toLowerCase().trim();
  const songs = adminSongsCache
    .filter(s => s.pdf && (!q || s.title.toLowerCase().includes(q)))
    .sort((a, b) => a.title.localeCompare(b.title, 'fr'));
  const list = document.getElementById('picker-list');
  if (!songs.length) {
    list.innerHTML = '<p class="px-4 py-5 text-center text-stone-400 italic">Aucun chant trouvé.</p>';
    return;
  }
  const occ = pickerCtx?.occasion || '';
  list.innerHTML = songs.map(s => {
    const hasOcc = !occ || s.occasions.includes(occ);
    return `<button
      data-pdf="${s.pdf}" data-title="${s.title.replace(/"/g,'&quot;')}"
      data-path="${s.path}" data-has-occ="${hasOcc}"
      class="picker-song-btn flex w-full items-center justify-between gap-3 px-4 py-2.5 text-left transition-colors hover:bg-stone-50">
      <div class="min-w-0">
        <span class="block truncate font-medium text-stone-900">${s.title}</span>
        <div class="mt-0.5 flex flex-wrap gap-1">
          ${s.occasions.map(o => `<span class="rounded-full bg-stone-100 px-1.5 text-xs text-stone-500">${o}</span>`).join('')}
        </div>
      </div>
      ${!hasOcc && occ ? `<span class="flex-shrink-0 rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">+ ${occ}</span>` : ''}
    </button>`;
  }).join('');
  list.querySelectorAll('.picker-song-btn').forEach(btn => {
    btn.addEventListener('click', () => pickSong(btn));
  });
}

async function pickSong(btn) {
  const { slot, occasion, container } = pickerCtx;
  const pdf     = btn.dataset.pdf;
  const title   = btn.dataset.title;
  const path    = btn.dataset.path;
  const hasOcc  = btn.dataset.hasOcc === 'true';
  const sel     = container.querySelector(`.slot-select[data-slot="${slot}"]`);
  const statusEl = container.querySelector(`.slot-status[data-slot="${slot}"]`);
  closeSongPicker();

  if (!hasOcc && occasion) {
    statusEl.textContent = '…';
    try {
      const d = await ghGet(`contents/${path}`);
      const md = b64decode(d.content);
      const song = adminSongsCache.find(s => s.path === path);
      const merged = [...new Set([...(song ? song.occasions : []), occasion])];
      const newMd = md.replace(/^occasion:\s*.+$/m, `occasion: ${formatOccasionYaml(merged)}`);
      await ghPut(path, b64encode(newMd), `tag: ${title} +${occasion}`, d.sha);
      statusEl.textContent = '✓';
      loadSongs(); triggerRebuild();
    } catch { statusEl.textContent = '✗'; return; }
  }

  const existing = sel.querySelector(`option[value="${pdf}"]`);
  if (existing) { existing.selected = true; }
  else { sel.appendChild(new Option(title, pdf, true, true)); }
}

function closeSongPicker() {
  pickerModal.style.display = 'none';
  document.body.style.overflow = '';
  pickerCtx = null;
}

document.getElementById('btn-close-picker').addEventListener('click', closeSongPicker);
pickerModal.addEventListener('click', e => { if (e.target === pickerModal) closeSongPicker(); });
document.getElementById('picker-search').addEventListener('input', e => renderPickerList(e.target.value));
</script>
