function parseOccasionStr(str) {
  if (!str) return [];
  str = str.trim();
  if (str.startsWith('[') && str.endsWith(']'))
    return str.slice(1, -1).split(',').map(s => s.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
  return [str.replace(/^["']|["']$/g, '')];
}
function formatOccasionYaml(arr) {
  if (!arr || arr.length === 0) return '""';
  if (arr.length === 1) return yamlStr(arr[0]);
  return '[' + arr.map(o => yamlStr(o)).join(', ') + ']';
}
