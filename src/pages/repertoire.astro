---
import {getCollection} from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allSongs = await getCollection('songs');
const songs = allSongs.sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr', {sensitivity: 'base'}));
const occasions = [...new Set(songs.flatMap(s => s.data.occasion))].filter(o => o !== 'En plus').sort((a, b) => a.localeCompare(b, 'fr'));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const isDev = import.meta.env.DEV;
const audioUrl = (path: string | undefined) => {
    if (!path) return '';
    if (path.startsWith('http://') || path.startsWith('https://')) return path;
    return `${base}${path.replace(/^\/+/, '')}`;
};
const isExternalAudio = (path: string | undefined) =>
    !!path && (path.startsWith('http://') || path.startsWith('https://'));
---

<Layout title="Répertoire | Voix Lactée">

    <!-- En-tête -->
    <div class="mb-8 flex items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight text-blue-950 sm:text-4xl">Répertoire</h1>
            <p class="subtitle mt-3 max-w-3xl">Chants utilisés pendant les célébrations liturgiques.</p>
        </div>
        <div class="mt-1 flex items-center gap-1">
            <button id="btn-prefs" title="Préférences"
                    class="rounded-full p-1.5 text-stone-300 transition-colors hover:bg-stone-100 hover:text-stone-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94H9.704c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                </svg>
            </button>
            {isDev && (
                <button id="btn-admin-toggle" title="Mode administration"
                        class="rounded-full p-1.5 text-stone-300 transition-colors hover:bg-stone-100 hover:text-stone-500"
                        aria-pressed="false">
                    <svg id="icon-locked" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                    </svg>
                    <svg id="icon-unlocked" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5 text-blue-700" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                    </svg>
                </button>
            )}
        </div>
    </div>

    <!-- Recherche + filtres -->
    <div class="mb-4 flex flex-wrap items-center gap-3">
        <input id="search-input" type="search" placeholder="Rechercher un chant..."
               class="flex-1 min-w-48 rounded-lg border border-stone-300 px-3 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"/>
        <div class="flex flex-wrap gap-2">
            <button data-filter=""
                    class="filter-btn rounded-full border border-blue-900 bg-blue-900 px-3 py-1 text-xs font-medium text-white transition-colors">
                Tous
            </button>
            {occasions.map(occasion => (
                    <button data-filter={occasion}
                            class="filter-btn rounded-full border border-stone-300 px-3 py-1 text-xs font-medium text-stone-600 transition-colors hover:border-blue-900 hover:bg-blue-50 hover:text-blue-900">
                        {occasion}
                    </button>
            ))}
        </div>
    </div>

    <!-- Tableau -->
    <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-stone-200 text-left">
            <thead class="bg-stone-100 text-xs uppercase tracking-wide text-stone-500">
            <tr>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Soprano">S</th>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Alto">A</th>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Ténor">T</th>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Basse">B</th>
                <th class="px-4 py-3 font-medium">Titre</th>
                <th class="px-4 py-3 font-medium">Occasion</th>
                <th class="px-4 py-3 font-medium">Partition</th>
                <th class="admin-col hidden px-4 py-3 font-medium">Actions</th>
            </tr>
            </thead>
            <tbody id="songs-tbody" class="divide-y divide-stone-100 text-sm text-stone-700">
            {songs.map((song) => (
                    <tr
                            data-title={song.data.title.toLowerCase()}
                            data-occasions={song.data.occasion.join(',')}
                            data-song-id={song.id}
                            data-song-title={song.data.title}
                            data-song-pdf={song.data.pdf || ''}
                            data-audio-s={audioUrl(song.data.audio_soprano)}
                            data-audio-a={audioUrl(song.data.audio_alto)}
                            data-audio-t={audioUrl(song.data.audio_tenor)}
                            data-audio-b={audioUrl(song.data.audio_basse)}
                    >
                        {/* Soprano */}
                        <td class="w-9 px-2 py-3 text-center">
                            {song.data.audio_soprano ? (
                                isExternalAudio(song.data.audio_soprano) ? (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-red-50 text-red-600 transition-colors hover:bg-red-100"
                                                data-voice="s" title="Soprano — Voir vidéo">
                                            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zm14.553 1.106A1 1 0 0016 8v4a1 1 0 00.553.894l2 1A1 1 0 0020 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                                            </svg>
                                        </button>
                                ) : (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-50 text-blue-700 transition-colors hover:bg-blue-100"
                                                data-voice="s" title="Soprano">
                                            <svg class="play-icon h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                            <svg class="pause-icon hidden h-3.5 w-3.5"
                                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                                 fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                )
                            ) : <span class="text-stone-200">–</span>}
                        </td>
                        {/* Alto */}
                        <td class="w-9 px-2 py-3 text-center">
                            {song.data.audio_alto ? (
                                isExternalAudio(song.data.audio_alto) ? (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-red-50 text-red-600 transition-colors hover:bg-red-100"
                                                data-voice="a" title="Alto — Voir vidéo">
                                            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zm14.553 1.106A1 1 0 0016 8v4a1 1 0 00.553.894l2 1A1 1 0 0020 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                                            </svg>
                                        </button>
                                ) : (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-50 text-blue-700 transition-colors hover:bg-blue-100"
                                                data-voice="a" title="Alto">
                                            <svg class="play-icon h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                            <svg class="pause-icon hidden h-3.5 w-3.5"
                                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                                 fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                )
                            ) : <span class="text-stone-200">–</span>}
                        </td>
                        {/* Ténor */}
                        <td class="w-9 px-2 py-3 text-center">
                            {song.data.audio_tenor ? (
                                isExternalAudio(song.data.audio_tenor) ? (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-red-50 text-red-600 transition-colors hover:bg-red-100"
                                                data-voice="t" title="Ténor — Voir vidéo">
                                            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zm14.553 1.106A1 1 0 0016 8v4a1 1 0 00.553.894l2 1A1 1 0 0020 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                                            </svg>
                                        </button>
                                ) : (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-50 text-blue-700 transition-colors hover:bg-blue-100"
                                                data-voice="t" title="Ténor">
                                            <svg class="play-icon h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                            <svg class="pause-icon hidden h-3.5 w-3.5"
                                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                                 fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                )
                            ) : <span class="text-stone-200">–</span>}
                        </td>
                        {/* Basse */}
                        <td class="w-9 px-2 py-3 text-center">
                            {song.data.audio_basse ? (
                                isExternalAudio(song.data.audio_basse) ? (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-red-50 text-red-600 transition-colors hover:bg-red-100"
                                                data-voice="b" title="Basse — Voir vidéo">
                                            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zm14.553 1.106A1 1 0 0016 8v4a1 1 0 00.553.894l2 1A1 1 0 0020 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                                            </svg>
                                        </button>
                                ) : (
                                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-50 text-blue-700 transition-colors hover:bg-blue-100"
                                                data-voice="b" title="Basse">
                                            <svg class="play-icon h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                            <svg class="pause-icon hidden h-3.5 w-3.5"
                                                 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                                 fill="currentColor">
                                                <path fill-rule="evenodd"
                                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z"
                                                      clip-rule="evenodd"/>
                                            </svg>
                                        </button>
                                )
                            ) : <span class="text-stone-200">–</span>}
                        </td>
                        <td class="px-4 py-3 text-stone-900">{song.data.title}</td>
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-1">
                                {song.data.occasion.map(occ => (
                                        <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-500">{occ}</span>
                                ))}
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            {song.data.pdfs && song.data.pdfs.length > 1 ? (
                                <button class="pdf-btn text-blue-800 underline"
                                        data-pdfs={JSON.stringify(song.data.pdfs.map(p => ({ label: p.label, url: `${base}${p.url.replace(/^\/+/, '')}` })))}>
                                    Voir PDF ▾
                                </button>
                            ) : song.data.pdfs && song.data.pdfs.length === 1 ? (
                                <button class="pdf-btn text-blue-800 underline"
                                        data-url={`${base}${song.data.pdfs[0].url.replace(/^\/+/, '')}`}>
                                    Voir PDF
                                </button>
                            ) : song.data.pdf ? (
                                <button class="pdf-btn text-blue-800 underline"
                                        data-url={`${base}${song.data.pdf.replace(/^\/+/, '')}`}>
                                    Voir PDF
                                </button>
                            ) : '–'}
                        </td>
                        <td class="admin-col hidden px-4 py-3">
                            <div class="flex items-center gap-2">
                                <button class="btn-delete-song rounded px-2 py-1 text-xs font-medium text-red-500 hover:bg-red-50 transition-colors">
                                    Supprimer
                                </button>
                            </div>
                        </td>
                    </tr>
                ))}
                </tbody>
                </table>
                <p id="no-results" class="hidden py-8 text-center text-sm text-stone-400">Aucun chant trouvé.</p>
                </div>

                <!-- Visionneuse YouTube -->
                <div id="yt-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-3"
                     style="display: none;">
                    <div class="relative w-full max-w-3xl overflow-hidden rounded-xl bg-black shadow-2xl">
                        <button id="btn-close-yt"
                                class="absolute right-3 top-3 z-10 flex items-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-sm font-semibold text-white backdrop-blur transition-colors hover:bg-white/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20"
                                 fill="currentColor">
                                <path fill-rule="evenodd"
                                      d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                      clip-rule="evenodd"/>
                            </svg>
                            Fermer
                        </button>
                        <div style="padding-top:56.25%;position:relative;">
                            <iframe id="yt-frame" src="" class="absolute inset-0 h-full w-full border-0"
                                    allow="autoplay; encrypted-media" allowfullscreen></iframe>
                        </div>
                    </div>
                </div>

                <!-- Visionneuse PDF -->
                <div id="pdf-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-3"
                     style="display: none;">
                    <div class="relative flex h-[95vh] w-[95vw] flex-col overflow-hidden rounded-xl bg-white shadow-2xl">
                        <button id="btn-close-pdf"
                                class="absolute right-4 top-4 z-10 flex items-center gap-2 rounded-lg bg-blue-900 px-4 py-2.5 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-blue-700">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20"
                                 fill="currentColor">
                                <path fill-rule="evenodd"
                                      d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                      clip-rule="evenodd"/>
                            </svg>
                            Fermer
                        </button>
                        <iframe id="pdf-frame" src="" class="h-full w-full border-0"></iframe>
                    </div>
                </div>

                <!-- Sélecteur de partition (multi-PDF) -->
                <div id="pdf-picker" class="fixed z-[60] rounded-lg border border-stone-200 bg-white py-1 shadow-lg" style="display:none; min-width:10rem;"></div>

                <!-- Panneau Préférences -->
                <div id="prefs-panel" class="fixed z-[70] rounded-lg border border-stone-200 bg-white p-4 shadow-lg" style="display:none; min-width:15rem;">
                    <h3 class="mb-3 text-sm font-semibold text-stone-700">Préférences</h3>
                    <p class="mb-2 text-xs font-medium text-stone-500">Ouverture des partitions PDF</p>
                    <div class="space-y-2">
                        <label class="flex cursor-pointer items-center gap-2">
                            <input type="radio" name="pdf-pref" value="modal" class="accent-blue-700"/>
                            <span class="text-sm text-stone-700">Modale (plein écran)</span>
                        </label>
                        <label class="flex cursor-pointer items-center gap-2">
                            <input type="radio" name="pdf-pref" value="tab" class="accent-blue-700"/>
                            <span class="text-sm text-stone-700">Nouvel onglet</span>
                        </label>
                    </div>
                </div>

                </Layout>

                <script>
                    // ── Admin mode (local uniquement) ──────────────────────────
                    const adminToggleBtn = document.getElementById('btn-admin-toggle') as HTMLButtonElement | null;
                    let adminMode = false;

                    function updateAdminUI() {
                        if (!adminToggleBtn) return;
                        document.querySelectorAll<HTMLElement>('.admin-col').forEach(el => {
                            el.classList.toggle('hidden', !adminMode);
                        });
                        document.getElementById('icon-locked')!.classList.toggle('hidden', adminMode);
                        document.getElementById('icon-unlocked')!.classList.toggle('hidden', !adminMode);
                        adminToggleBtn.setAttribute('aria-pressed', String(adminMode));
                    }

                    if (adminToggleBtn) {
                        adminMode = sessionStorage.getItem('vl_admin') === '1';
                        adminToggleBtn.addEventListener('click', () => {
                            adminMode = !adminMode;
                            sessionStorage.setItem('vl_admin', adminMode ? '1' : '0');
                            updateAdminUI();
                        });
                        updateAdminUI();
                    }

                    // ── YouTube overlay ────────────────────────────────────────
                    const ytOverlay = document.getElementById('yt-overlay') as HTMLElement;
                    const ytFrame = document.getElementById('yt-frame') as HTMLIFrameElement;

                    function getYouTubeId(url: string): string | null {
                        const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
                        return m ? m[1] : null;
                    }

                    function openYouTubeOverlay(url: string) {
                        const id = getYouTubeId(url);
                        if (id) {
                            ytFrame.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
                            ytOverlay.style.display = 'flex';
                            document.body.style.overflow = 'hidden';
                        } else {
                            window.open(url, '_blank');
                        }
                    }

                    function closeYouTubeOverlay() {
                        ytOverlay.style.display = 'none';
                        ytFrame.src = '';
                        document.body.style.overflow = '';
                    }

                    document.getElementById('btn-close-yt')!.addEventListener('click', closeYouTubeOverlay);
                    ytOverlay.addEventListener('click', (e) => {
                        if (e.target === ytOverlay) closeYouTubeOverlay();
                    });

                    // ── Audio ──────────────────────────────────────────────────
                    const audioPlayer = new Audio();
                    let currentBtn: HTMLButtonElement | null = null;

                    function setPlaying(btn: HTMLButtonElement, playing: boolean) {
                        btn.querySelector('.play-icon')!.classList.toggle('hidden', playing);
                        btn.querySelector('.pause-icon')!.classList.toggle('hidden', !playing);
                        btn.classList.toggle('bg-blue-700', playing);
                        btn.classList.toggle('text-white', playing);
                        btn.classList.toggle('bg-blue-50', !playing);
                        btn.classList.toggle('text-blue-700', !playing);
                    }

                    audioPlayer.addEventListener('ended', () => {
                        if (currentBtn) {
                            setPlaying(currentBtn, false);
                            currentBtn = null;
                        }
                    });

                    // ── Délégation d'événements ────────────────────────────────
                    document.getElementById('songs-tbody')!.addEventListener('click', (e) => {
                        const target = e.target as HTMLElement;

                        const audioBtn = target.closest<HTMLButtonElement>('.audio-btn');
                        if (audioBtn) {
                            const row = audioBtn.closest('tr') as HTMLTableRowElement;
                            const voice = audioBtn.dataset.voice!;
                            const url = (row.dataset as any)[`audio${voice.toUpperCase()}`] as string;
                            if (!url) return;
                            if (url.startsWith('http://') || url.startsWith('https://')) {
                                openYouTubeOverlay(url);
                                return;
                            }
                            if (currentBtn === audioBtn && !audioPlayer.paused) {
                                audioPlayer.pause();
                                setPlaying(audioBtn, false);
                                currentBtn = null;
                            } else {
                                if (currentBtn) setPlaying(currentBtn, false);
                                audioPlayer.src = url;
                                audioPlayer.play();
                                setPlaying(audioBtn, true);
                                currentBtn = audioBtn;
                            }
                            return;
                        }

                        if (target.closest('.btn-delete-song')) {
                            const row = target.closest('tr') as HTMLTableRowElement;
                            const title = row.dataset.songTitle || 'ce chant';
                            if (!confirm(`Supprimer « ${title} » du répertoire ?`)) return;
                            row.remove();
                            return;
                        }

                        const pdfBtn = target.closest<HTMLButtonElement>('.pdf-btn');
                        if (pdfBtn) {
                            const pdfsRaw = pdfBtn.dataset.pdfs;
                            if (pdfsRaw) {
                                e.stopPropagation();
                                showPdfPicker(pdfBtn, JSON.parse(pdfsRaw));
                            } else {
                                openPdf(pdfBtn.dataset.url!);
                            }
                        }
                    });

                    // ── Recherche + filtre ─────────────────────────────────────
                    const searchInput = document.getElementById('search-input') as HTMLInputElement;
                    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
                    const noResults = document.getElementById('no-results')!;
                    let activeFilter = '';

                    function applyFilters() {
                        const query = searchInput.value.toLowerCase().trim();
                        const rows = document.querySelectorAll<HTMLTableRowElement>('#songs-tbody tr');
                        let visible = 0;
                        rows.forEach(row => {
                            const show = (row.dataset.title || '').includes(query) && (!activeFilter || (row.dataset.occasions || '').split(',').includes(activeFilter));
                            row.style.display = show ? '' : 'none';
                            if (show) visible++;
                        });
                        noResults.classList.toggle('hidden', visible > 0);
                    }

                    searchInput.addEventListener('input', applyFilters);
                    filterBtns.forEach(btn => {
                        btn.addEventListener('click', () => {
                            activeFilter = btn.dataset.filter!;
                            filterBtns.forEach(b => {
                                const on = b === btn;
                                b.classList.toggle('bg-blue-900', on);
                                b.classList.toggle('text-white', on);
                                b.classList.toggle('border-blue-900', on);
                                b.classList.toggle('text-stone-600', !on);
                                b.classList.toggle('border-stone-300', !on);
                            });
                            applyFilters();
                        });
                    });

                    // ── Sélecteur de partition (multi-PDF) ────────────────────
                    const pdfPicker = document.getElementById('pdf-picker') as HTMLElement;

                    function showPdfPicker(btn: HTMLElement, pdfs: Array<{label: string, url: string}>) {
                        pdfPicker.innerHTML = pdfs.map(p =>
                            `<button class="pdf-picker-item block w-full truncate rounded px-3 py-1.5 text-left text-sm text-stone-700 hover:bg-blue-50 hover:text-blue-800" data-url="${p.url}">${p.label}</button>`
                        ).join('');
                        const rect = btn.getBoundingClientRect();
                        pdfPicker.style.top = `${rect.bottom + 4}px`;
                        pdfPicker.style.left = `${rect.left}px`;
                        pdfPicker.style.display = 'block';
                    }

                    pdfPicker.addEventListener('click', (e) => {
                        const item = (e.target as HTMLElement).closest<HTMLButtonElement>('.pdf-picker-item');
                        if (item) {
                            pdfPicker.style.display = 'none';
                            openPdf(item.dataset.url!);
                        }
                    });

                    document.addEventListener('click', (e) => {
                        if (!pdfPicker.contains(e.target as Node)) {
                            pdfPicker.style.display = 'none';
                        }
                    });

                    // ── Visionneuse PDF ────────────────────────────────────────
                    const pdfOverlay = document.getElementById('pdf-overlay') as HTMLElement;
                    const pdfFrame = document.getElementById('pdf-frame') as HTMLIFrameElement;

                    function openPdf(url: string) {
                        const pref = localStorage.getItem('vl_pdf_pref') || 'modal';
                        if (pref === 'tab') {
                            window.open(url, '_blank', 'noopener');
                        } else {
                            pdfFrame.src = url;
                            pdfOverlay.style.display = 'flex';
                            document.body.style.overflow = 'hidden';
                        }
                    }

                    document.getElementById('btn-close-pdf')!.addEventListener('click', closePdf);
                    pdfOverlay.addEventListener('click', (e) => {
                        if (e.target === pdfOverlay) closePdf();
                    });

                    function closePdf() {
                        pdfOverlay.style.display = 'none';
                        pdfFrame.src = '';
                        document.body.style.overflow = '';
                    }

                    // ── Préférences ────────────────────────────────────────────
                    const prefsBtn = document.getElementById('btn-prefs') as HTMLButtonElement;
                    const prefsPanel = document.getElementById('prefs-panel') as HTMLElement;
                    const pdfPrefRadios = document.querySelectorAll<HTMLInputElement>('input[name="pdf-pref"]');

                    const savedPref = localStorage.getItem('vl_pdf_pref') || 'modal';
                    pdfPrefRadios.forEach(r => { r.checked = r.value === savedPref; });

                    prefsBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const isOpen = prefsPanel.style.display !== 'none';
                        if (isOpen) {
                            prefsPanel.style.display = 'none';
                        } else {
                            const rect = prefsBtn.getBoundingClientRect();
                            prefsPanel.style.top = `${rect.bottom + 4}px`;
                            prefsPanel.style.right = `${window.innerWidth - rect.right}px`;
                            prefsPanel.style.left = 'auto';
                            prefsPanel.style.display = 'block';
                        }
                    });

                    pdfPrefRadios.forEach(r => {
                        r.addEventListener('change', () => {
                            localStorage.setItem('vl_pdf_pref', r.value);
                        });
                    });

                    document.addEventListener('click', (e) => {
                        if (!prefsPanel.contains(e.target as Node)) {
                            prefsPanel.style.display = 'none';
                        }
                    });
                    </script>
