---
import {getCollection} from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allSongs = await getCollection('songs');
const songs = allSongs.sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr', {sensitivity: 'base'}));
const occasions = [...new Set(songs.flatMap(s => s.data.occasion))].filter(o => o !== 'En plus').sort((a, b) => a.localeCompare(b, 'fr'));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const audioUrl = (path: string | undefined) => {
    if (!path) return '';
    if (path.startsWith('http://') || path.startsWith('https://')) return path;
    return `${base}${path.replace(/^\/+/, '')}`;
};
const isExternalAudio = (url: string) => url.startsWith('http://') || url.startsWith('https://');
const buildVoiceData = (variants: Array<{label: string, url: string}> | undefined, fallbackLabel: string) =>
    (variants ?? []).map(v => ({ label: v.label || fallbackLabel, url: audioUrl(v.url) }));
---

<Layout title="Répertoire | Voix Lactée">

    <!-- En-tête -->
    <div class="mb-8 flex items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-semibold tracking-tight text-blue-950 sm:text-4xl">Répertoire</h1>
            <p class="subtitle mt-3 max-w-3xl">Chants utilisés pendant les célébrations liturgiques.</p>
        </div>
    </div>

    <!-- Recherche + filtres -->
    <div class="mb-4 flex flex-wrap items-center gap-3">
        <input id="search-input" type="search" placeholder="Rechercher un chant..."
               class="flex-1 min-w-48 rounded-lg border border-stone-300 px-3 py-2 text-sm text-stone-900 placeholder:text-stone-400 focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700"/>
        <div class="flex flex-wrap gap-2">
            <button data-filter=""
                    class="filter-btn rounded-full border border-blue-900 bg-blue-900 px-3 py-1 text-xs font-medium text-white transition-colors">
                Tous
            </button>
            {occasions.map(occasion => (
                    <button data-filter={occasion}
                            class="filter-btn rounded-full border border-stone-300 px-3 py-1 text-xs font-medium text-stone-600 transition-colors hover:border-blue-900 hover:bg-blue-50 hover:text-blue-900">
                        {occasion}
                    </button>
            ))}
        </div>
    </div>

    <!-- Tableau -->
    <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-stone-200 text-left">
            <thead class="bg-stone-100 text-xs uppercase tracking-wide text-stone-500">
            <tr>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Soprano">S</th>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Alto">A</th>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Ténor">T</th>
                <th class="w-9 px-2 py-3 text-center font-medium" title="Basse">B</th>
                <th class="px-4 py-3 font-medium">Titre</th>
                <th class="px-4 py-3 font-medium">Occasion</th>
                <th class="px-4 py-3 font-medium">Partition</th>
            </tr>
            </thead>
            <tbody id="songs-tbody" class="divide-y divide-stone-100 text-sm text-stone-700">
            {songs.map((song) => {
                const combinedS = [
                    ...buildVoiceData(song.data.audio_soprano, 'Soprano'),
                    ...buildVoiceData(song.data.audio_tutti, 'Tutti'),
                ];
                const combinedA = buildVoiceData(song.data.audio_alto, 'Alto');
                const combinedT = buildVoiceData(song.data.audio_tenor, 'Ténor');
                const combinedB = buildVoiceData(song.data.audio_basse, 'Basse');
                const voiceBtn = (combined: typeof combinedS, voice: string, title: string) => {
                    if (combined.length === 0) return <span class="text-stone-200">–</span>;
                    const singleExt = combined.length === 1 && isExternalAudio(combined[0].url);
                    return singleExt ? (
                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-red-50 text-red-600 transition-colors hover:bg-red-100"
                                data-voice={voice} title={`${title} — Voir vidéo`}>
                            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zm14.553 1.106A1 1 0 0016 8v4a1 1 0 00.553.894l2 1A1 1 0 0020 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                            </svg>
                        </button>
                    ) : (
                        <button class="audio-btn inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-50 text-blue-700 transition-colors hover:bg-blue-100"
                                data-voice={voice} title={title}>
                            <svg class="play-icon h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                            </svg>
                            <svg class="pause-icon hidden h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                        </button>
                    );
                };
                return (
                    <tr
                            data-title={song.data.title.toLowerCase()}
                            data-occasions={song.data.occasion.join(',')}
                            data-song-id={song.id}
                            data-song-title={song.data.title}
                            data-song-pdf={song.data.pdf || ''}
                            data-audio-s={JSON.stringify(combinedS)}
                            data-audio-a={JSON.stringify(combinedA)}
                            data-audio-t={JSON.stringify(combinedT)}
                            data-audio-b={JSON.stringify(combinedB)}
                    >
                        {/* Soprano */}
                        <td class="w-9 px-2 py-3 text-center">{voiceBtn(combinedS, 's', 'Soprano')}</td>
                        {/* Alto */}
                        <td class="w-9 px-2 py-3 text-center">{voiceBtn(combinedA, 'a', 'Alto')}</td>
                        {/* Ténor */}
                        <td class="w-9 px-2 py-3 text-center">{voiceBtn(combinedT, 't', 'Ténor')}</td>
                        {/* Basse */}
                        <td class="w-9 px-2 py-3 text-center">{voiceBtn(combinedB, 'b', 'Basse')}</td>
                        <td class="px-4 py-3 text-stone-900">{song.data.title}</td>
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-1">
                                {song.data.occasion.map(occ => (
                                        <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-500">{occ}</span>
                                ))}
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            {song.data.pdfs && song.data.pdfs.length > 1 ? (
                                <button class="pdf-btn text-blue-800 underline"
                                        data-pdfs={JSON.stringify(song.data.pdfs.map(p => ({ label: p.label, url: `${base}${p.url.replace(/^\/+/, '')}` })))}>
                                    Voir PDF ▾
                                </button>
                            ) : song.data.pdfs && song.data.pdfs.length === 1 ? (
                                <button class="pdf-btn text-blue-800 underline"
                                        data-url={`${base}${song.data.pdfs[0].url.replace(/^\/+/, '')}`}>
                                    Voir PDF
                                </button>
                            ) : song.data.pdf ? (
                                <button class="pdf-btn text-blue-800 underline"
                                        data-url={`${base}${song.data.pdf.replace(/^\/+/, '')}`}>
                                    Voir PDF
                                </button>
                            ) : '–'}
                        </td>
                    </tr>
                );
            })}
                </tbody>
                </table>
                <p id="no-results" class="hidden py-8 text-center text-sm text-stone-400">Aucun chant trouvé.</p>
                </div>

                <!-- Visionneuse YouTube -->
                <div id="yt-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-3"
                     style="display: none;">
                    <div class="relative w-full max-w-3xl overflow-hidden rounded-xl bg-black shadow-2xl">
                        <button id="btn-close-yt"
                                class="absolute right-3 top-3 z-10 flex items-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-sm font-semibold text-white backdrop-blur transition-colors hover:bg-white/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20"
                                 fill="currentColor">
                                <path fill-rule="evenodd"
                                      d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                      clip-rule="evenodd"/>
                            </svg>
                            Fermer
                        </button>
                        <div style="padding-top:56.25%;position:relative;">
                            <iframe id="yt-frame" src="" class="absolute inset-0 h-full w-full border-0"
                                    allow="autoplay; encrypted-media" allowfullscreen></iframe>
                        </div>
                    </div>
                </div>

                <!-- Visionneuse PDF -->
                <div id="pdf-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-3"
                     style="display: none;">
                    <div class="relative flex h-[95vh] w-[95vw] flex-col overflow-hidden rounded-xl bg-white shadow-2xl">
                        <div class="flex shrink-0 items-center justify-between border-b border-stone-200 px-4 py-3">
                            <div class="flex items-center gap-2">
                                <span id="pdf-status" class="text-sm text-stone-500">Chargement…</span>
                                <button id="pdf-zoom-out" class="flex h-7 w-7 items-center justify-center rounded border border-stone-300 text-lg leading-none text-stone-600 hover:bg-stone-100 disabled:opacity-30" title="Réduire">−</button>
                                <button id="pdf-zoom-in"  class="flex h-7 w-7 items-center justify-center rounded border border-stone-300 text-lg leading-none text-stone-600 hover:bg-stone-100 disabled:opacity-30" title="Agrandir">+</button>
                            </div>
                            <div class="flex items-center gap-2">
                                <button id="btn-back-pdf"
                                        class="hidden items-center gap-2 rounded-lg bg-stone-100 px-4 py-2.5 text-sm font-semibold text-stone-700 transition-colors hover:bg-stone-200">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                                    </svg>
                                    Retour
                                </button>
                                <button id="btn-close-pdf"
                                        class="flex items-center gap-2 rounded-lg bg-blue-900 px-4 py-2.5 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-blue-700">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                    </svg>
                                    Fermer
                                </button>
                            </div>
                        </div>
                        <div id="pdf-container" class="flex flex-1 flex-col items-center gap-4 overflow-auto bg-stone-100 p-4"></div>
                    </div>
                </div>

                <!-- Sélecteur de partition (multi-PDF) -->
                <div id="pdf-picker" class="fixed z-[60] rounded-lg border border-stone-200 bg-white py-1 shadow-lg" style="display:none; min-width:10rem;"></div>

                <!-- Sélecteur audio (multi-audio) -->
                <div id="audio-picker" class="fixed z-[70] rounded-lg border border-stone-200 bg-white py-1 shadow-lg" style="display:none; min-width:10rem;"></div>

</Layout>

                <script>
                    import * as pdfjsLib from 'pdfjs-dist';
                    pdfjsLib.GlobalWorkerOptions.workerSrc = import.meta.env.BASE_URL + 'pdf.worker.min.mjs';

                    // ── YouTube overlay ────────────────────────────────────────
                    const ytOverlay = document.getElementById('yt-overlay') as HTMLElement;
                    const ytFrame = document.getElementById('yt-frame') as HTMLIFrameElement;

                    function getYouTubeId(url: string): string | null {
                        const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
                        return m ? m[1] : null;
                    }

                    function openYouTubeOverlay(url: string) {
                        const id = getYouTubeId(url);
                        if (id) {
                            ytFrame.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
                            ytOverlay.style.display = 'flex';
                            document.body.style.overflow = 'hidden';
                            history.pushState({ modal: 'yt' }, '');
                        } else {
                            window.open(url, '_blank');
                        }
                    }

                    function closeYouTubeOverlay() {
                        ytOverlay.style.display = 'none';
                        ytFrame.src = '';
                        document.body.style.overflow = '';
                    }

                    document.getElementById('btn-close-yt')!.addEventListener('click', () => {
                        history.back();
                    });
                    ytOverlay.addEventListener('click', (e) => {
                        if (e.target === ytOverlay) history.back();
                    });

                    // ── Audio ──────────────────────────────────────────────────
                    const audioPlayer = new Audio();
                    let currentBtn: HTMLButtonElement | null = null;

                    function setPlaying(btn: HTMLButtonElement, playing: boolean) {
                        btn.querySelector('.play-icon')!.classList.toggle('hidden', playing);
                        btn.querySelector('.pause-icon')!.classList.toggle('hidden', !playing);
                        btn.classList.toggle('bg-blue-700', playing);
                        btn.classList.toggle('text-white', playing);
                        btn.classList.toggle('bg-blue-50', !playing);
                        btn.classList.toggle('text-blue-700', !playing);
                    }

                    audioPlayer.addEventListener('ended', () => {
                        if (currentBtn) {
                            setPlaying(currentBtn, false);
                            currentBtn = null;
                        }
                    });

                    // ── Délégation d'événements ────────────────────────────────
                    document.getElementById('songs-tbody')!.addEventListener('click', (e) => {
                        const target = e.target as HTMLElement;

                        const audioBtn = target.closest<HTMLButtonElement>('.audio-btn');
                        if (audioBtn) {
                            const row = audioBtn.closest('tr') as HTMLTableRowElement;
                            const voice = audioBtn.dataset.voice!;
                            const variantsJson = (row.dataset as any)[`audio${voice.toUpperCase()}`] as string;
                            let variants: Array<{label: string, url: string}> = [];
                            try { variants = JSON.parse(variantsJson || '[]'); } catch {}
                            if (!variants.length) return;
                            if (variants.length > 1) {
                                showAudioPicker(audioBtn, variants);
                                return;
                            }
                            const url = variants[0].url;
                            if (url.startsWith('http://') || url.startsWith('https://')) {
                                openYouTubeOverlay(url);
                                return;
                            }
                            if (currentBtn === audioBtn && !audioPlayer.paused) {
                                audioPlayer.pause();
                                setPlaying(audioBtn, false);
                                currentBtn = null;
                            } else {
                                if (currentBtn) setPlaying(currentBtn, false);
                                audioPlayer.src = url;
                                audioPlayer.play();
                                setPlaying(audioBtn, true);
                                currentBtn = audioBtn;
                            }
                            return;
                        }

                        const pdfBtn = target.closest<HTMLButtonElement>('.pdf-btn');
                        if (pdfBtn) {
                            const pdfsRaw = pdfBtn.dataset.pdfs;
                            if (pdfsRaw) {
                                e.stopPropagation();
                                showPdfPicker(pdfBtn, JSON.parse(pdfsRaw));
                            } else {
                                openPdf(pdfBtn.dataset.url!);
                            }
                        }
                    });

                    // ── Recherche + filtre ─────────────────────────────────────
                    const searchInput = document.getElementById('search-input') as HTMLInputElement;
                    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
                    const noResults = document.getElementById('no-results')!;
                    let activeFilter = '';

                    function applyFilters() {
                        const query = searchInput.value.toLowerCase().trim();
                        const rows = document.querySelectorAll<HTMLTableRowElement>('#songs-tbody tr');
                        let visible = 0;
                        rows.forEach(row => {
                            const show = (row.dataset.title || '').includes(query) && (!activeFilter || (row.dataset.occasions || '').split(',').includes(activeFilter));
                            row.style.display = show ? '' : 'none';
                            if (show) visible++;
                        });
                        noResults.classList.toggle('hidden', visible > 0);
                    }

                    searchInput.addEventListener('input', applyFilters);
                    filterBtns.forEach(btn => {
                        btn.addEventListener('click', () => {
                            activeFilter = btn.dataset.filter!;
                            filterBtns.forEach(b => {
                                const on = b === btn;
                                b.classList.toggle('bg-blue-900', on);
                                b.classList.toggle('text-white', on);
                                b.classList.toggle('border-blue-900', on);
                                b.classList.toggle('text-stone-600', !on);
                                b.classList.toggle('border-stone-300', !on);
                            });
                            applyFilters();
                        });
                    });

                    // ── Sélecteur de partition (multi-PDF) ────────────────────
                    const pdfPicker = document.getElementById('pdf-picker') as HTMLElement;
                    let lastPickerBtn: HTMLElement | null = null;
                    let lastPickerPdfs: Array<{label: string, url: string}> = [];

                    function showPdfPicker(btn: HTMLElement, pdfs: Array<{label: string, url: string}>) {
                        lastPickerBtn = btn;
                        lastPickerPdfs = pdfs;
                        pdfPicker.innerHTML = pdfs.map(p =>
                            `<button class="pdf-picker-item block w-full truncate rounded px-3 py-1.5 text-left text-sm text-stone-700 hover:bg-blue-50 hover:text-blue-800" data-url="${p.url}">${p.label}</button>`
                        ).join('');
                        const rect = btn.getBoundingClientRect();
                        pdfPicker.style.top = `${rect.bottom + 4}px`;
                        pdfPicker.style.left = `${rect.left}px`;
                        pdfPicker.style.display = 'block';
                    }

                    pdfPicker.addEventListener('click', (e) => {
                        const item = (e.target as HTMLElement).closest<HTMLButtonElement>('.pdf-picker-item');
                        if (item) {
                            pdfPicker.style.display = 'none';
                            openPdf(item.dataset.url!, true);
                        }
                    });

                    // ── Sélecteur audio (multi-audio) ─────────────────────────
                    const audioPicker = document.getElementById('audio-picker') as HTMLElement;
                    let currentAudioPickerBtn: HTMLButtonElement | null = null;

                    function showAudioPicker(btn: HTMLButtonElement, variants: Array<{label: string, url: string}>) {
                        currentAudioPickerBtn = btn;
                        audioPicker.innerHTML = variants.map(v =>
                            `<button class="audio-picker-item block w-full truncate rounded px-3 py-1.5 text-left text-sm text-stone-700 hover:bg-blue-50 hover:text-blue-800" data-url="${v.url}" data-is-external="${v.url.startsWith('http://') || v.url.startsWith('https://')}">${v.label}</button>`
                        ).join('');
                        const rect = btn.getBoundingClientRect();
                        audioPicker.style.top = `${rect.bottom + 4}px`;
                        audioPicker.style.left = `${rect.left}px`;
                        audioPicker.style.display = 'block';
                    }

                    audioPicker.addEventListener('click', (e) => {
                        const item = (e.target as HTMLElement).closest<HTMLButtonElement>('.audio-picker-item');
                        if (item) {
                            audioPicker.style.display = 'none';
                            const url = item.dataset.url!;
                            if (item.dataset.isExternal === 'true') {
                                openYouTubeOverlay(url);
                                return;
                            }
                            const btn = currentAudioPickerBtn;
                            if (btn) {
                                if (currentBtn) setPlaying(currentBtn, false);
                                audioPlayer.src = url;
                                audioPlayer.play();
                                setPlaying(btn, true);
                                currentBtn = btn;
                            }
                        }
                    });

                    document.addEventListener('click', (e) => {
                        if (!pdfPicker.contains(e.target as Node)) {
                            pdfPicker.style.display = 'none';
                        }
                        if (!audioPicker.contains(e.target as Node)) {
                            audioPicker.style.display = 'none';
                        }
                    });

                    // ── Visionneuse PDF (pdfjs-dist) ──────────────────────────
                    const pdfOverlay   = document.getElementById('pdf-overlay')   as HTMLElement;
                    const pdfContainer = document.getElementById('pdf-container') as HTMLElement;
                    const pdfStatus    = document.getElementById('pdf-status')    as HTMLElement;
                    const btnBackPdf   = document.getElementById('btn-back-pdf')  as HTMLButtonElement;
                    let pdfLoadingTask: any = null;
                    let pdfZoom = 1.0;
                    const pdfPages: Array<{el: HTMLCanvasElement; w: number; h: number}> = [];

                    function applyZoom() {
                        pdfPages.forEach(p => {
                            p.el.style.width  = `${p.w * pdfZoom}px`;
                            p.el.style.height = `${p.h * pdfZoom}px`;
                        });
                    }

                    document.getElementById('pdf-zoom-in')!.addEventListener('click', () => {
                        pdfZoom = Math.min(3, pdfZoom * 1.25);
                        applyZoom();
                    });
                    document.getElementById('pdf-zoom-out')!.addEventListener('click', () => {
                        pdfZoom = Math.max(0.25, pdfZoom / 1.25);
                        applyZoom();
                    });

                    // Scroll + pincement via Pointer Events (touch-action:none donne le contrôle total)
                    pdfContainer.style.touchAction = 'none';
                    const _ptrs = new Map<number, PointerEvent>();
                    let _pinchDist = 0;
                    let _scrollStart = { y: 0, top: 0 };

                    pdfContainer.addEventListener('pointerdown', (e) => {
                        _ptrs.set(e.pointerId, e);
                        pdfContainer.setPointerCapture(e.pointerId);
                        if (_ptrs.size === 1) {
                            _scrollStart = { y: e.clientY, top: pdfContainer.scrollTop };
                        }
                        if (_ptrs.size === 2) {
                            const [a, b] = [..._ptrs.values()];
                            _pinchDist = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
                        }
                    });
                    pdfContainer.addEventListener('pointermove', (e) => {
                        if (!_ptrs.has(e.pointerId)) return;
                        _ptrs.set(e.pointerId, e);
                        if (_ptrs.size === 1) {
                            pdfContainer.scrollTop = _scrollStart.top + (_scrollStart.y - e.clientY);
                        } else if (_ptrs.size === 2) {
                            const [a, b] = [..._ptrs.values()];
                            const dist = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);
                            if (_pinchDist > 0) {
                                pdfZoom = Math.min(3, Math.max(0.25, pdfZoom * dist / _pinchDist));
                                applyZoom();
                            }
                            _pinchDist = dist;
                        }
                    }, { passive: false });
                    pdfContainer.addEventListener('pointerup', (e) => {
                        _ptrs.delete(e.pointerId);
                        if (_ptrs.size < 2) _pinchDist = 0;
                        if (_ptrs.size === 1) {
                            const [r] = [..._ptrs.values()];
                            _scrollStart = { y: r.clientY, top: pdfContainer.scrollTop };
                        }
                    });
                    pdfContainer.addEventListener('pointercancel', (e) => {
                        _ptrs.delete(e.pointerId);
                        if (_ptrs.size < 2) _pinchDist = 0;
                    });

                    async function openPdf(url: string, fromPicker = false) {
                        if (localStorage.getItem('vl_pdf_pref') === 'tab') {
                            window.open(url, '_blank', 'noopener');
                            return;
                        }
                        if (pdfLoadingTask) pdfLoadingTask.destroy();
                        pdfContainer.innerHTML = '';
                        pdfPages.length = 0;
                        pdfZoom = 1.0;
                        pdfStatus.textContent = 'Chargement…';
                        btnBackPdf.classList.toggle('hidden', !fromPicker);
                        btnBackPdf.classList.toggle('flex', fromPicker);
                        pdfOverlay.style.display = 'flex';
                        document.body.style.overflow = 'hidden';
                        try {
                            pdfLoadingTask = pdfjsLib.getDocument(url);
                            const pdf = await pdfLoadingTask.promise;
                            const w = Math.max(pdfContainer.clientWidth - 32, 200);
                            for (let n = 1; n <= pdf.numPages; n++) {
                                const page = await pdf.getPage(n);
                                const base = page.getViewport({ scale: 1 });
                                const scale = Math.min(w / base.width, 3);
                                const vp = page.getViewport({ scale });
                                const dpr = window.devicePixelRatio || 1;
                                const canvas = document.createElement('canvas');
                                canvas.width  = Math.floor(vp.width  * dpr);
                                canvas.height = Math.floor(vp.height * dpr);
                                canvas.style.width    = `${vp.width}px`;
                                canvas.style.height   = `${vp.height}px`;
                                canvas.style.minWidth = '0';
                                canvas.className = 'shadow-md';
                                pdfContainer.appendChild(canvas);
                                pdfPages.push({ el: canvas, w: vp.width, h: vp.height });
                                const ctx = canvas.getContext('2d')!;
                                ctx.scale(dpr, dpr);
                                await page.render({ canvasContext: ctx, viewport: vp }).promise;
                            }
                            pdfStatus.textContent = `${pdf.numPages} page${pdf.numPages > 1 ? 's' : ''}`;
                        } catch (err: any) {
                            if (err?.name !== 'RenderingCancelledException') {
                                console.error('[pdfjs]', err);
                                pdfStatus.textContent = 'Erreur';
                                pdfContainer.innerHTML = `<p class="p-4 text-red-500">Impossible de charger le PDF.<br><code class="text-xs">${err?.message ?? err}</code></p>`;
                            }
                        }
                    }

                    function closePdf() {
                        pdfOverlay.style.display = 'none';
                        pdfContainer.innerHTML = '';
                        pdfPages.length = 0;
                        if (pdfLoadingTask) { pdfLoadingTask.destroy(); pdfLoadingTask = null; }
                        document.body.style.overflow = '';
                    }

                    document.getElementById('btn-close-pdf')!.addEventListener('click', closePdf);
                    pdfOverlay.addEventListener('click', (e) => { if (e.target === pdfOverlay) closePdf(); });

                    btnBackPdf.addEventListener('click', () => {
                        closePdf();
                        if (lastPickerBtn && lastPickerPdfs.length) {
                            showPdfPicker(lastPickerBtn, lastPickerPdfs);
                        }
                    });

                    // ── Retour arrière navigateur / Android ───────────────────
                    window.addEventListener('popstate', (e) => {
                        if (ytOverlay.style.display !== 'none') {
                            closeYouTubeOverlay();
                        }
                    });

                    </script>
