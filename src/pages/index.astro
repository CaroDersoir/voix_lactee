---
import SectionTitle from '../components/SectionTitle.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Voix Lactee | Chorale catholique">
	<SectionTitle
		title="Voix Lactee"
		subtitle="Chorale catholique au service de la liturgie, de la priere et de la beaute du chant sacre."
	/>
	<section class="grid gap-6 rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:grid-cols-2">
		<div>
			<h2 class="text-xl font-semibold text-emerald-950">Notre mission</h2>
			<p class="mt-3 text-stone-700">
				Nous animons les messes dominicales, les fetes liturgiques et les temps forts paroissiaux avec un
				repertoire allant du gregorien au chant liturgique contemporain.
			</p>
		</div>
		<div>
			<h2 class="text-xl font-semibold text-emerald-950">Rejoindre la chorale</h2>
			<p class="mt-3 text-stone-700">
				Les repetitions ont lieu chaque jeudi soir. Tous les pupitres sont bienvenus, quel que soit le niveau.
			</p>
		</div>
	</section>
</Layout>
