---
import {Image} from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo_voix_lactee_wbg.png';
---

<Layout title="Voix Lactee | Chorale catholique">
    <div class="mb-10 flex flex-col items-center text-center">
        <Image src={logo} alt="Logo Voix Lactée" class="h-40 w-auto mb-4"/>
        <h1 class="text-4xl font-semibold tracking-tight text-blue-950">Voix Lactée</h1>
        <p class="subtitle mt-3 max-w-xl">Chorale catholique au service de la liturgie, de la prière et de la beauté du
            chant sacré.</p>
    </div>
    <section class="grid gap-6 rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:grid-cols-2">
        <div>
            <h2 class="text-xl font-semibold text-blue-950">Notre mission</h2>
            <p class="mt-3 text-stone-700">
                Bienvenue dans the chorale spatiale, où les notes filent à la vitesse de la lumière.
                Ici, on chante (avec passion), on brille (fort) et on vise les étoiles (même si on arrive parfois en
                orbite basse).
                Tenue de cosmonaute non exigée — juste des cordes vocales, de la bonne humeur et un peu de folie
                stellaire.
            </p>
        </div>
        <div>
            <h2 class="text-xl font-semibold text-blue-950">Rejoindre la chorale</h2>
            <p class="mt-3 text-stone-700">
                Les répétitions ont lieu chaque mercredi soir.
            </p>
            <p class="mt-3 text-stone-700">
                A l'origine, le rendez-vous est à 18h45, mais en réalité cela dépend surtout des retards d'Enguerrand et
                Guilhem... quand la cheffe de choeur s'est réveillée de sa sieste...
            </p>
            <p class="mt-3 text-stone-700">
                Tous les pupitres sont bienvenus, quel que soit le niveau.
            </p>
        </div>
    </section>

    <div id="repets-section" class="hidden rounded-xl border border-blue-200 bg-blue-50 p-6 shadow-sm mt-6">
        <div class="flex items-start justify-between gap-4 mb-4">
            <div>
                <h2 class="text-xl font-semibold text-blue-950">Chants à travailler</h2>
                <p id="repets-titre" class="text-sm text-blue-700/70 mt-0.5"></p>
            </div>
        </div>
        <ul id="repets-list" class="space-y-2"></ul>
    </div>

    <section class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm mt-6">
        <h2 class="text-xl font-semibold text-blue-950 mb-1">Proposer un chant</h2>
        <p class="text-sm text-stone-500 mb-4">Une idée de chant pour la chorale ? Laissez-nous un message.</p>
        <form name="proposition-chant" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-3" id="form-proposition">
            <input type="hidden" name="form-name" value="proposition-chant" />
            <p class="hidden"><label>Ne pas remplir : <input name="bot-field" /></label></p>
            <textarea
                name="proposition"
                rows="3"
                required
                placeholder="Prière de Madame Elizabeth, (optionnel) https://lienVersYoutube.com"
                class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700 resize-none"
            ></textarea>
            <button type="submit"
                class="rounded-lg bg-blue-900 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-800">
                Envoyer
            </button>
        </form>
        <p id="form-merci" class="hidden text-sm text-green-700 mt-3">Merci pour votre proposition !</p>
    </section>
</Layout>

<script>
    const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

    fetch('https://raw.githubusercontent.com/CaroDersoir/voix_lactee/main/src/data/repets.json?t=' + Date.now())
        .then(r => r.json())
        .then((data: { titre?: string; chants?: string[] }) => {
            if (!data.chants?.length) return;
            const section = document.getElementById('repets-section')!;
            const titreEl = document.getElementById('repets-titre')!;
            const list = document.getElementById('repets-list')!;
            if (data.titre) titreEl.textContent = data.titre;
            data.chants.forEach((c, i) => {
                const li = document.createElement('li');
                const href = `${base}repertoire?q=${encodeURIComponent(c)}`;
                li.innerHTML = `<a href="${href}" class="flex items-center gap-3 rounded-lg bg-white/70 px-4 py-3 text-blue-950 font-medium shadow-sm hover:bg-white hover:shadow transition-all">
                    <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-blue-900 text-xs font-semibold text-white">${i + 1}</span>
                    ${c}
                </a>`;
                list.appendChild(li);
            });
            section.classList.remove('hidden');
        })
        .catch(() => {});
</script>

<script>
    const form = document.getElementById('form-proposition') as HTMLFormElement | null;
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        await fetch('/', { method: 'POST', body: data });
        form.style.display = 'none';
        document.getElementById('form-merci')?.classList.remove('hidden');
    });
</script>
